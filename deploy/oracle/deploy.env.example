# Settings for the scripts in deploy/oracle. Copy this file to deploy/oracle/deploy.env
# (which git ignores) and fill it in. The scripts read it as a bash file.

# Public IP address (or host name) of the VM, for SSH.
HOST=203.0.113.10

# SSH user on the VM. Oracle's Ubuntu images use "ubuntu", which has passwordless sudo.
SSH_USER=ubuntu

# Host name of the site. Caddy gets a Let's Encrypt certificate for it, so its DNS A record
# must point at HOST before the certificate can be issued.
DOMAIN=species.example.org

# Optional. Let's Encrypt sends certificate expiry warnings to this address.
ACME_EMAIL=

# .NET runtime identifier to publish for. linux-arm64 for Ampere A1 VMs,
# linux-x64 for the x86 E2.1.Micro VMs.
RID=linux-arm64

# Optional settings.
# SSH_PORT=22
# SSH_KEY=~/.ssh/id_ed25519
#
# Database to deploy when deploy-db.sh is run without a path. Without this, deploy-db.sh reads
# [Datastore] site_sqlite from BeastieBot3/paths.ini (or from PATHS_INI).
# SITE_DB=~/datasets/beastiebot/site.sqlite
# PATHS_INI=~/sync/dropbox/projects/BeastieBot3/BeastieBot3/paths.ini
#
# Folder on this computer for the published app and the compressed database
# (default ~/.cache/beastiebot-deploy). Keep it outside synced folders such as Dropbox.
# WORK_DIR=~/.cache/beastiebot-deploy
#
# zstd compression level for the database upload (default 10).
# ZSTD_LEVEL=10
#
# Seconds to wait for /healthz to answer after a restart (default 60).
# HEALTH_TIMEOUT=60
#
# Time of day (server time, HH:MM) at which the server may restart itself after a security update
# that needs a reboot. Empty means never: you restart the server by hand.
# AUTO_REBOOT_AT=04:30
