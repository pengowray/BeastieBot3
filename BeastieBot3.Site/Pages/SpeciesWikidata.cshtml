@page "/species/{taxonId:long}/wikidata"
@model SpeciesWikidataModel
@{
    var taxon = Model.Taxon;
    if (taxon is null) {
        ViewData["Title"] = SiteText.TaxonNotFoundHeading(Model.RequestedTaxonId);
        ViewData["HideHeaderSearch"] = true;
    } else {
        ViewData["Title"] = SiteText.CitationsPageTitle(SiteText.TaxonTitle(taxon.SubpopulationName is { Length: > 0 } subpopulation ? $"{taxon.ScientificName} {subpopulation}" : taxon.ScientificName, taxon.CommonNameEn), wikidata: true);
    }
}
@if (taxon is null) {
    <h1>@SiteText.TaxonNotFoundHeading(Model.RequestedTaxonId)</h1>
    <p>@(Model.Version is null ? SiteText.TaxonNotFoundLineNoVersion : SiteText.TaxonNotFoundLine(Model.Version))</p>
    <partial name="_SearchForm" model="@(new SearchFormModel(null, "main"))" />
    return;
}
@{
    var selected = Model.Selected;
}

@{ ViewData["ToolTab"] = BeastieBot3.Site.Web.ToolPaths.Tab.Cite; }
<partial name="_CitationsHeader" model="Model" />

@if (selected is null) {
    <p class="note">@SiteText.WikidataChooseAssessment(Model.Version)</p>
}
<section class="wikitext" id="wikitext" aria-labelledby="wikitext-heading"
         data-copied="@SiteText.Copied" data-copy-label="@SiteText.Copy" data-copy-failed="@SiteText.CopyFailed" data-copy-failed-button="@SiteText.CopyFailedButton">
    <partial name="_CiteForChooser" model="Model.Chooser" />
    @if (selected is not null && !Model.SelectedIsDefault) {
        var selectedCategory = IucnCategories.Describe(selected).Label;
        <p class="note note-selected">
            @(selected.IsGlobal
                ? SiteText.WikidataEarlierAssessment(selectedCategory, selected.YearPublished, Model.VersionNote(selected))
                : SiteText.WikidataRegionalAssessment(selected.Scope, selectedCategory, selected.YearPublished, Model.VersionNote(selected)))
            @if (Model.StatusAssessment is not null) {
                <a href="@Model.OptionsUrl(null)">@SiteText.ShowLatestWikidata</a>
            }
        </p>
    }
    @if (Model.Wikidata is { } wikidata) {
        <partial name="_WikidataItemSection" model="@(new WikidataItemPartial(wikidata, Model))" />
    }
    @if (Model.WikidataStatus is { HasContent: true } wikidataStatus && Model.LatestGlobal is { } latestGlobal) {
        <partial name="_WikidataStatus" model="@(new WikidataStatusPartial(wikidataStatus, latestGlobal, Model.Version))" />
    }
</section>

<partial name="_AssessmentTables" model="Model" />
