                    <td><a href="@SiteText.TermsUrl">IUCN Red List Terms of Use</a></td>
                    <td>Version @Model.Version.@if (Model.ApiDateRange is not null) {<text> Assessment details downloaded from the IUCN Red List API @Model.ApiDateRange.</text>}</td>
                </tr>
                @if (Model.Table7Versions is not null || Model.Table9Versions is not null) {
