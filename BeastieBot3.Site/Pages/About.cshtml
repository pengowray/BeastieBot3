                        <td>@SiteText.AboutSummaryTablesUse</td>
                        <td><a href="@SiteText.TermsUrl">IUCN Red List Terms of Use</a></td>
                        <td>@SiteText.AboutSummaryTablesVersions(Model.Table7Versions, Model.Table9Versions)</td>
                    </tr>
