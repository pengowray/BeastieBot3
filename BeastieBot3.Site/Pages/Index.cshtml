@page
@model IndexModel
@{
    ViewData["HideHeaderSearch"] = true;
    var snapshot = Model.Snapshot;
}
<section class="home-intro">
    <h1>@SiteText.SiteName</h1>
    <p class="lead">@SiteText.Description</p>
</section>

<partial name="_SearchForm" model="@(new SearchFormModel(null, "main"))" />

@if (Model.Examples.Count > 0) {
    <p class="examples">
        @SiteText.ExamplesLabel
        @for (var i = 0; i < Model.Examples.Count; i++) {
            var example = Model.Examples[i];
            <a href="@example.Url">@if (example.Italic) {<i>@example.Text</i>} else {@example.Text}</a>@(i < Model.Examples.Count - 1 ? ", " : "")
        }
    </p>
}

<section class="home-what" aria-labelledby="what-heading">
    <h2 id="what-heading" class="small-heading">@SiteText.WhatHeading</h2>
    <ul>
        <li>@SiteText.What1</li>
        <li>@SiteText.What2</li>
        <li>@SiteText.What3</li>
    </ul>
</section>

<p class="home-update"><a href="/update-statuses">@UpdateText.HomeLink</a></p>

@if (snapshot?.IucnRelease is { } release && snapshot.AssessmentCount is { } assessments) {
    <p class="dataset-summary">@SiteText.DatasetSummary(release, snapshot.GlobalTaxonCount, assessments)</p>
}
