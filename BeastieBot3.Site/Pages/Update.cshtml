@page "/update"
@model UpdateModel
@using BeastieBot3.Site.Update
@{
    ViewData["Title"] = UpdateText.Heading;
    var result = Model.Result;
}
@* A textarea drops one newline straight after its start tag, so one is written there to keep a
   text that starts with a newline. *@
<h1>@UpdateText.Heading</h1>
<div class="update-intro prose">
    <p>@UpdateText.Intro(Model.Version)</p>
    <p>@UpdateText.IntroItemsLabel</p>
    <ul>
        <li><strong>@UpdateText.IntroTemplatesTitle</strong>@UpdateText.IntroTemplates</li>
        <li><strong>@UpdateText.IntroTablesTitle</strong>@UpdateText.IntroTables</li>
        <li><strong>@UpdateText.IntroTaxoboxesTitle</strong>@UpdateText.IntroTaxoboxes</li>
        <li><strong>@UpdateText.IntroListsTitle</strong>@UpdateText.IntroLists</li>
        <li><strong>@UpdateText.IntroSpeciesTablesTitle</strong>@UpdateText.IntroSpeciesTables</li>
    </ul>
    <p class="help">@UpdateText.IntroLimits(StatusUpdater.DefaultMaxItems)</p>
</div>

@if (Model.Error is not null) {
    <p class="update-error" role="alert">@Model.Error</p>
}

@if (Model.LoadedPage is { } loaded) {
    var wikiTitle = Uri.EscapeDataString(loaded.Title.Replace(' ', '_'));
    <p class="update-loaded">@UpdateText.LoadedFromPrefix<a href="https://en.wikipedia.org/wiki/@wikiTitle">@loaded.Title</a>,
        <a href="https://en.wikipedia.org/w/index.php?oldid=@loaded.RevisionId">@UpdateText.LoadedRevision(loaded.RevisionId, loaded.Timestamp)</a>.
        <a href="https://en.wikipedia.org/w/index.php?title=@wikiTitle&amp;action=edit">@UpdateText.EditOnWikipedia</a></p>
}

@if (result is not null) {
    <section class="update-result wikitext" id="result" aria-labelledby="result-heading"
             data-copied="@SiteText.Copied" data-copy-label="@SiteText.Copy" data-copy-failed="@SiteText.CopyFailed" data-copy-failed-button="@SiteText.CopyFailedButton">
        <h2 id="result-heading">@UpdateText.ResultHeading</h2>
        <p class="update-summary">@(result.NotChecked > 0
            ? UpdateText.SummaryCapped(StatusUpdater.DefaultMaxItems, result.Updated, result.Current, result.NotUpdated, result.NotChecked)
            : UpdateText.Summary(result.Updated, result.Current, result.NotUpdated, result.ListLinesWithoutStatus + result.TablesWithoutStatus > 0))</p>
        @if (result.Updated == 0 && result.MissingAdded == 0 && result.Findings.Count > 0) {
            <p class="note">@UpdateText.NoChanges</p>
        }
        @{
            var offers = new List<(int Count, string Text, string Field, string Button)>();
            if (!Model.Options.PossiblyExtinctCodes && result.CountNotes(StatusNoteKind.PossiblyExtinctKept) is > 0 and var pe) {
                offers.Add((pe, UpdateText.OfferPossiblyExtinct(pe), UpdateModel.PossiblyExtinctField, UpdateText.OfferPossiblyExtinctButton));
            }
            if (!Model.Options.AddIds && result.CountNotes(StatusNoteKind.IdsNotAdded) is > 0 and var ids) {
                offers.Add((ids, UpdateText.OfferIds(ids), UpdateModel.IdsField, UpdateText.OfferIdsButton));
            }
            if (!Model.Options.AddIds && result.CountNotes(StatusNoteKind.AssessmentIdNotAdded) is > 0 and var assessmentIds) {
                offers.Add((assessmentIds, UpdateText.OfferAssessmentIds(assessmentIds), UpdateModel.IdsField, UpdateText.OfferIdsButton));
            }
            if (!Model.Options.AddYear && result.CountNotes(StatusNoteKind.YearNotAdded) is > 0 and var years) {
                offers.Add((years, UpdateText.OfferYear(years), UpdateModel.YearField, UpdateText.OfferYearButton));
            }
            if (!Model.Options.MatchCommonNames && result.CountNotes(StatusNoteKind.CommonNameNotUsed) is > 0 and var commons) {
                offers.Add((commons, UpdateText.OfferCommonNames(commons), UpdateModel.CommonNamesField, UpdateText.OfferCommonNamesButton));
            }
            if (!Model.Options.AddToListLines && result.ListLinesWithoutStatus is > 0 and var lines) {
                offers.Add((lines, UpdateText.OfferListLines(lines), UpdateModel.AddToListLinesField, UpdateText.OfferListLinesButton));
            }
            if (!Model.Options.AddStatusColumns && result.TablesWithoutStatus is > 0 and var tables) {
                offers.Add((tables, UpdateText.OfferStatusColumns(tables), UpdateModel.AddStatusColumnsField, UpdateText.OfferStatusColumnsButton(tables)));
            }
            if (!Model.Options.UpdateCitations && result.CountNotes(StatusNoteKind.CitationOlder) is > 0 and var cites) {
                offers.Add((cites, UpdateText.OfferCitations(cites), UpdateModel.CitationsField, UpdateText.OfferCitationsButton));
            }
        }
        @if (offers.Count > 0) {
            @* Each button sends the form below again with its option ticked. *@
            <ul class="update-offers">
                @foreach (var offer in offers) {
                    <li><span>@offer.Text</span> <button type="submit" form="update-form" name="@offer.Field" value="1">@offer.Button</button></li>
                }
            </ul>
        }
        @if (EditSummary.For(result, Model.Version) is { } editSummary) {
            <div class="wikitext-box">
                <div class="wikitext-box-head">
                    <label for="update-edit-summary">@UpdateText.EditSummaryLabel</label>
                    <button type="button" class="copy-button" data-copy="update-edit-summary" aria-label="@UpdateText.CopyEditSummaryAccessible" hidden>@SiteText.Copy</button>
                    <p class="copy-status" role="status" aria-live="polite"></p>
                </div>
                <textarea id="update-edit-summary" class="update-readonly" readonly rows="2" spellcheck="false" autocapitalize="off" autocomplete="off" aria-describedby="update-edit-summary-help">@editSummary</textarea>
                <p class="help" id="update-edit-summary-help">@UpdateText.EditSummaryHelp</p>
            </div>
        }
        <div class="wikitext-box">
            <div class="wikitext-box-head">
                <label for="update-output">@UpdateText.OutputLabel</label>
                <button type="button" class="copy-button" data-copy="update-output" aria-label="@UpdateText.CopyOutputAccessible" hidden>@SiteText.Copy</button>
                <p class="copy-status" role="status" aria-live="polite"></p>
            </div>
            <textarea id="update-output" class="update-output" readonly rows="16" spellcheck="false" autocapitalize="off" autocomplete="off">@("\n" + result.Text)</textarea>
        </div>

        @if (result.Findings.Count > 0) {
            var changedCount = result.Findings.Count(f => f.Outcome == StatusOutcome.Updated);
            var leftCount = result.Findings.Count(f => f.Outcome == StatusOutcome.NotUpdated);
            var currentCount = result.Findings.Count(f => f.Outcome == StatusOutcome.Current);
            var show = changedCount > 0 ? "changed" : leftCount > 0 ? "left" : "all";
            <div class="update-findings">
            <h3 id="report-heading">@UpdateText.ReportHeading</h3>
            @* The rows are filtered by CSS (:has), so the choice works without JavaScript and keeps
               no state; a browser without :has shows every row. *@
            <fieldset class="update-filter">
                <legend>@UpdateText.FilterLegend</legend>
                <label><input type="radio" name="show" id="show-changed" checked="@(show == "changed")"> @UpdateText.FilterChanged(changedCount)</label>
                <label><input type="radio" name="show" id="show-current"> @UpdateText.FilterCurrent(currentCount)</label>
                <label><input type="radio" name="show" id="show-left" checked="@(show == "left")"> @UpdateText.FilterLeft(leftCount)</label>
                <label><input type="radio" name="show" id="show-all" checked="@(show == "all")"> @UpdateText.FilterAll(result.Findings.Count)</label>
            </fieldset>
            <div class="table-scroll">
                <table class="update-report" aria-labelledby="report-heading">
                    <thead>
                        <tr>
                            <th scope="col">@UpdateText.ColumnLine</th>
                            <th scope="col">@UpdateText.ColumnResult</th>
                            <th scope="col">@UpdateText.ColumnItem</th>
                            <th scope="col">@UpdateText.ColumnBefore</th>
                            <th scope="col">@UpdateText.ColumnAfter</th>
                            <th scope="col">@UpdateText.ColumnTaxon</th>
                            @if (Model.ShowEpbc) {<th scope="col">@UpdateText.ColumnEpbc</th>}
                            <th scope="col">@UpdateText.ColumnNotes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var finding in result.Findings) {
                            <tr class="@UpdateText.OutcomeClass(finding.Outcome)">
                                <td>@finding.Line.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</td>
                                <td class="update-outcome">@UpdateText.Outcome(finding.Outcome)</td>
                                <td>@UpdateText.Kind(finding.Kind)</td>
                                <td><code class="update-code">@finding.Before</code></td>
                                <td>@if (finding.After is not null) {<code class="update-code">@finding.After</code>}</td>
                                <td>@if (finding.Taxon is { } taxon) {<a href="/species/@taxon.TaxonId">@Html.Raw(ScientificNameMarkup.ToHtml(taxon.ScientificName))</a>}</td>
                                @if (Model.ShowEpbc) {<td>@UpdateText.Epbc(finding.Taxon is { } t ? Model.Epbc.GetValueOrDefault(t.TaxonId) : null)</td>}
                                <td>
                                    @foreach (var note in finding.Notes) {
                                        <p class="update-note">@UpdateText.Note(note, finding.Kind)</p>
                                    }
                                    @if (finding.Kind == StatusItemKind.TableColumnAdded && !finding.Notes.Any(n => n.Kind == StatusNoteKind.ColumnLayout)) {
                                        @* Belongs to the update form, so it is sent with the text. *@
                                        <label class="update-note"><input type="checkbox" form="update-form" name="@UpdateModel.ColumnTablesField" value="@finding.Line" checked="@(finding.Outcome == StatusOutcome.Updated)"> @UpdateText.ColumnChosen</label>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            </div>
        }

        @if (result.Populations.Count > 0) {
            <h3 id="population-heading">@UpdateText.PopulationHeading</h3>
            <p>@UpdateText.PopulationIntro</p>
            <p class="help">@UpdateText.PopulationKey</p>
            <div class="table-scroll">
                <table class="update-report" aria-labelledby="population-heading">
                    <thead>
                        <tr>
                            <th scope="col">@UpdateText.ColumnLine</th>
                            <th scope="col">@UpdateText.ColumnTaxon</th>
                            <th scope="col">@UpdateText.ColumnPopulationNow</th>
                            <th scope="col">@UpdateText.ColumnPopulationIucn</th>
                            <th scope="col">@UpdateText.ColumnPopulationSuggested</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in result.Populations) {
                            <tr>
                                <td>@p.Line.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</td>
                                <td><a href="/species/@p.Taxon.TaxonId">@Html.Raw(ScientificNameMarkup.ToHtml(p.Taxon.ScientificName))</a></td>
                                <td><code class="update-code">@p.Current</code></td>
                                <td>@UpdateText.PopulationIucnValue(p.IucnValue, p.Year)</td>
                                <td><code class="update-code">@p.Suggested</code></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (Model.Scope is { } scope) {
            @await Html.PartialAsync("_ListScope", new ListScopeView(scope, Model.Placement, Model.AddMissing, Model.ExtraSpecies, Model.Categories, Model.ShowEpbc ? Model.Epbc : null))
        }
    </section>
}

<form class="update-form" id="update-form" method="post" action="/update#result" enctype="multipart/form-data">
    <label for="update-input">@UpdateText.InputLabel</label>
    <textarea id="update-input" name="@UpdateModel.TextField" rows="16" spellcheck="false" autocapitalize="off" autocomplete="off" required>@("\n" + Model.Input)</textarea>
    <fieldset class="update-options">
        <legend>@UpdateText.OptionsLegend</legend>
        <label><input type="checkbox" name="@UpdateModel.PossiblyExtinctField" value="1" checked="@Model.Options.PossiblyExtinctCodes"> @UpdateText.OptionPossiblyExtinct</label>
        <label><input type="checkbox" name="@UpdateModel.IdsField" value="1" checked="@Model.Options.AddIds"> @UpdateText.OptionIds</label>
        <label><input type="checkbox" name="@UpdateModel.YearField" value="1" checked="@Model.Options.AddYear"> @UpdateText.OptionYear</label>
        <label><input type="checkbox" name="@UpdateModel.CitationsField" value="1" checked="@Model.Options.UpdateCitations"> @UpdateText.OptionCitations</label>
        <label><input type="checkbox" name="@UpdateModel.CiteQField" value="1" checked="@Model.Options.CiteQ"> @UpdateText.OptionCiteQ</label>
        <label><input type="checkbox" name="@UpdateModel.CommonNamesField" value="1" checked="@Model.Options.MatchCommonNames"> @UpdateText.OptionCommonNames</label>
        <label><input type="checkbox" name="@UpdateModel.EpbcField" value="1" checked="@Model.ShowEpbc"> @UpdateText.OptionEpbc</label>
    </fieldset>
    <fieldset class="update-options" aria-describedby="update-add-help">
        <legend>@UpdateText.AddOptionsLegend</legend>
        <label><input type="checkbox" name="@UpdateModel.AddToListLinesField" value="1" checked="@Model.Options.AddToListLines"> @UpdateText.OptionAddToListLines</label>
        <label><input type="checkbox" name="@UpdateModel.AtLineEndField" value="1" checked="@Model.Options.StatusAtLineEnd"> @UpdateText.OptionAtLineEnd</label>
        <label><input type="checkbox" name="@UpdateModel.AddStatusColumnsField" value="1" checked="@Model.Options.AddStatusColumns"> @UpdateText.OptionAddStatusColumns</label>
        <label>@UpdateText.OptionColumnHeader
            <select name="@UpdateModel.ColumnHeaderField">
                @foreach (var heading in UpdateModel.ColumnHeaders) {
                    <option value="@heading" selected="@(heading == (Model.Options.ColumnHeader ?? UpdateModel.ColumnHeaders[0]))">@heading</option>
                }
            </select>
        </label>
        <label><input type="checkbox" name="@UpdateModel.AddReferencesField" value="1" checked="@Model.Options.AddReferences" aria-describedby="update-refs-help"> @UpdateText.OptionAddReferences</label>
        <p class="help" id="update-refs-help">@UpdateText.OptionAddReferencesHelp</p>
        <p class="help" id="update-add-help">@UpdateText.AddOptionsHelp</p>
    </fieldset>
    @if (Model.LoadedPage is { } loadedPage) {
        <input type="hidden" name="@UpdateModel.PageField" value="@loadedPage.Title">
        <input type="hidden" name="@UpdateModel.RevisionField" value="@loadedPage.RevisionId">
        <input type="hidden" name="@UpdateModel.PageKeyField" value="@UpdateModel.TextKey(Model.Input)">
        @if (loadedPage.Timestamp is { } time) {
            <input type="hidden" name="@UpdateModel.PageTimeField" value="@time.ToString("O", System.Globalization.CultureInfo.InvariantCulture)">
        }
    }
    @if (result?.Findings.Any(f => f.Kind == StatusItemKind.TableColumnAdded) == true) {
        <input type="hidden" name="@UpdateModel.ColumnTablesShownField" value="@UpdateModel.TextKey(Model.Input)">
    }
    <div class="update-actions">
        <button type="submit">@UpdateText.Submit</button>
        <p class="help">@UpdateText.NotSaved</p>
    </div>
</form>
