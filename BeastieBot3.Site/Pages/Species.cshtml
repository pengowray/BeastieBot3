@page "/species/{taxonId:long}"
@model SpeciesModel
@{
    var taxon = Model.Taxon;
    if (taxon is null) {
        ViewData["Title"] = SiteText.TaxonNotFoundHeading(Model.RequestedTaxonId);
        ViewData["HideHeaderSearch"] = true;
    } else {
        ViewData["Title"] = taxon.CommonNameEn is null ? taxon.ScientificName : $"{taxon.ScientificName} ({taxon.CommonNameEn})";
    }
}
@if (taxon is null) {
    <h1>@SiteText.TaxonNotFoundHeading(Model.RequestedTaxonId)</h1>
    <p>@(Model.Version is null ? SiteText.TaxonNotFoundLineNoVersion : SiteText.TaxonNotFoundLine(Model.Version))</p>
    <partial name="_SearchForm" model="@(new SearchFormModel(null, "main"))" />
    return;
}
@{
    var status = Model.StatusAssessment;
    var parentPrefix = SiteText.ParentLinePrefix(taxon.Kind);
    var plainName = taxon.SubpopulationName is { Length: > 0 } subpopulation ? $"{taxon.ScientificName} {subpopulation}" : taxon.ScientificName;
    ViewData["PageTools"] = new List<(string, string)> { (SiteText.WikitextPageTitle(plainName), SpeciesWikitextModel.PathFor(taxon.TaxonId)) };
    var ranks = new[] { taxon.Kingdom, taxon.Phylum, taxon.ClassName, taxon.OrderName, taxon.Family, taxon.Genus };
}

@if (Model.ArrivedQuery is { } arrived) {
    <p class="arrival">
        @if (!Model.ArrivedNameIsShown) {
            @(Model.ArrivedNameType == NameTypes.Synonym ? SiteText.ArrivedSynonym(arrived) : SiteText.ArrivedCommonName(arrived))
        }
        <a href="/search?q=@Uri.EscapeDataString(arrived)&amp;all=1">@SiteText.ArrivedAllResults(arrived)</a>
    </p>
}

<header class="taxon-header">
    <h1>
        <span class="sci-name">@Html.Raw(ScientificNameMarkup.ToHtml(taxon.ScientificName, taxon.SubpopulationName))</span>
        @if (!string.IsNullOrWhiteSpace(taxon.Authority)) {
            <span class="authority">@taxon.Authority</span>
        }
    </h1>
    @if (taxon.CommonNameEn is not null) {
        <p class="taxon-common-name">@taxon.CommonNameEn</p>
    }
    @if (SiteFormat.ProvisionalMarker(taxon.ScientificName) is { } provisional) {
        <p class="provisional-note">@SiteText.ProvisionalName(provisional.Marker, provisional.Rank, Model.Names.Synonyms.Count > 0)</p>
    }
    @if (parentPrefix is not null && Model.Parent is { } parent) {
        <p class="parent-line">@parentPrefix <a href="/species/@parent.TaxonId">@Html.Raw(ScientificNameMarkup.ToHtml(parent.ScientificName, parent.SubpopulationName))</a></p>
    }
    @if (Model.Classification.Count > 0) {
        var colCount = Model.Classification.Count(g => g.IsCol);
        @* The groups link to their pages. Catalogue of Life groups are hidden until the box is ticked
           (site.css, :has), so the page needs no script for it. *@
        <div class="classification has-col-toggle">
            <h2 id="short-classification-heading" class="visually-hidden">@SiteText.HeadingShortClassification</h2>
            <ol>
                @foreach (var step in Model.Classification) {
                    var colNames = step.CommonNameEn is null ? Model.ClassificationColNames.GetValueOrDefault(step.NodeId) : null;
                    <li class="@(step.IsCol ? "col-group" : null)">
                        @if (step.ShowRank && step.Rank != "unranked") {
                            <span class="rank">@BeastieBot3.Site.Lists.GroupList.Capitalize(step.Rank)</span>
                        }
                        <a href="@BeastieBot3.Site.Web.SiteUrls.Group(step)">@if (step.IsGenus) {<i>@step.Name</i>} else {@step.Name}</a>
                        @if (step.CommonNameEn is not null) {
                            <span class="group-common">@step.CommonNameEn</span>
                        } else if (colNames is { Count: > 0 }) {
                            <span class="group-common col-names" title="@GroupText.ColNamesTitle">@string.Join(", ", colNames.Take(3))</span>
                        }
                        @if (step.IsCol) {
                            <abbr class="col-marker" title="@GroupText.ColMarkerTitle">@GroupText.ColMarker</abbr>
                        } else if (step.IsFromRule) {
                            <span class="rule-marker" title="@GroupText.RuleMarkerTitle(step.Rank)">@GroupText.RuleMarker</span>
                        }
                    </li>
                }
            </ol>
            @if (colCount > 0) {
                <label class="col-toggle"><input type="checkbox" class="show-col" autocomplete="off"> @GroupText.ShowColRanks(colCount)</label>
            }
        </div>
    } else if (ranks.Any(r => !string.IsNullOrWhiteSpace(r))) {
        @* The ranks are plain text, so they sit in a div with a hidden heading (a nav landmark is for links). *@
        <div class="classification">
            <h2 id="short-classification-heading" class="visually-hidden">@SiteText.HeadingShortClassification</h2>
            <ol>
                @for (var i = 0; i < ranks.Length; i++) {
                    if (string.IsNullOrWhiteSpace(ranks[i])) {
                        continue;
                    }
                    var value = SiteFormat.TitleCase(ranks[i]!);
                    <li><span class="rank">@SiteText.RankLabels[i]</span> @if (i == ranks.Length - 1) {<i>@value</i>} else {<text>@value</text>}</li>
                }
            </ol>
        </div>
    }
</header>

<section class="status" aria-labelledby="status-heading">
    <h2 id="status-heading">@(Model.LatestGlobal is null ? SiteText.HeadingStatusNoGlobal : SiteText.HeadingStatus)</h2>
    @if (!Model.InRelease) {
        <p class="no-global-line">@SiteText.NoCurrentLine(Model.Version)</p>
        @foreach (var link in Model.LinkedTaxa) {
            var current = link.Taxon;
            var currentName = ScientificNameMarkup.ToHtml(current.ScientificName, current.SubpopulationName);
            if (link.IsSynonym) {
                <p class="current-taxon">@SiteText.SynonymOfBefore<span class="sci-name">@Html.Raw(ScientificNameMarkup.ToHtml(taxon.ScientificName, taxon.SubpopulationName))</span>@SiteText.SynonymOfMiddle<span class="sci-name">@Html.Raw(currentName)</span>@SiteText.SynonymOfBeforeLink<a href="/species/@current.TaxonId">@SiteText.IucnIdLink(current.TaxonId)</a>@SiteText.SynonymOfAfter</p>
            } else {
                <p class="current-taxon">@SiteText.CurrentTaxonBefore(Model.Version)<span class="sci-name">@Html.Raw(currentName)</span>@SiteText.CurrentTaxonMiddle<a href="/species/@current.TaxonId">@SiteText.IucnIdLink(current.TaxonId)</a>@SiteText.CurrentTaxonAfter</p>
            }
        }
    } else if (Model.LatestGlobal is null && Model.RegionalRows.Count > 0) {
        var regions = Model.RegionalRows.Count(r => !r.HasNoScope);
        var noScope = Model.RegionalRows.Count(r => r.HasNoScope);
        if (regions > 0) {
            <p class="no-global-line">@SiteText.NoGlobalBefore<a href="#regional">@SiteText.NoGlobalLinkText(regions)</a>@SiteText.NoGlobalAfter</p>
        }
        if (noScope > 0) {
            <p class="no-global-line">@SiteText.NoScopeLine(noScope, withNoGlobal: regions == 0)</p>
        }
    }
    @if (status is not null) {
        <dl class="facts">
            @if (!status.IsGlobal) {
                <dt>@SiteText.LabelRegion</dt>
                <dd>@SiteText.RegionLabel(status.Scope)</dd>
            }
            <dt>@SiteText.LabelCategory</dt>
            <dd><partial name="_Badge" model="@BadgeModel.For(status, large: true)" /></dd>
            <dt>@SiteText.LabelCriteria</dt>
            <dd>@(string.IsNullOrWhiteSpace(status.Criteria) ? SiteText.CriteriaNone : status.Criteria)</dd>
            @if (!string.IsNullOrWhiteSpace(status.PopulationTrend)) {
                <dt>@SiteText.LabelTrend</dt>
                <dd>@status.PopulationTrend</dd>
            }
            @if (!string.IsNullOrWhiteSpace(status.AssessmentDate)) {
                <dt>@SiteText.LabelAssessed</dt>
                <dd>@SiteFormat.Date(status.AssessmentDate)</dd>
            }
            @if (status.YearPublished is { } published) {
                <dt>@SiteText.LabelPublished</dt>
                <dd>@published</dd>
            }
            @if (Model.Version is not null) {
                <dt>@SiteText.LabelVersion</dt>
                <dd>@Model.Version</dd>
            }
        </dl>
        <p class="iucn-link"><a href="@SiteFormat.IucnAssessmentUrl(status.TaxonId, status.AssessmentId)">@SiteText.IucnLink</a></p>
        @if (!string.IsNullOrWhiteSpace(Model.StatusParts?.IucnCitationText) || Model.StatusCredits is not null) {
            <div class="citation-notes">
                @if (!string.IsNullOrWhiteSpace(Model.StatusParts?.IucnCitationText)) {
                    <details class="iucn-citation" id="iucn-citation">
                        <summary>@SiteText.IucnCitationLabel</summary>
                        <p>@Model.StatusParts.IucnCitationText</p>
                    </details>
                }
                @if (Model.StatusCredits is { } credits) {
                    <partial name="_AssessmentCredits" model="credits" />
                }
            </div>
        }
    }
</section>

<partial name="_AssessmentTables" model="Model" />

<section class="related" id="related" aria-labelledby="related-heading">
@if (Model.IsSpecies) {
    var kinds = Model.RelatedTaxa.Select(r => r.Taxon.Kind).ToHashSet();
    <h2 id="related-heading">@SiteText.HeadingInfraTaxa(taxon.Kingdom, kinds.Contains(TaxonKinds.Subspecies), kinds.Contains(TaxonKinds.Variety), kinds.Contains(TaxonKinds.Subpopulation))</h2>
    if (Model.RelatedTaxa.Count == 0) {
        <p>@SiteText.NoInfraTaxa(taxon.Kingdom)</p>
    } else {
        <partial name="_RelatedTaxaTable" model="Model.RelatedTaxa" />
    }
} else if (Model.SpeciesRow is not null || Model.UnassessedSpeciesName is not null) {
    <h2 id="related-heading">@SiteText.HeadingSpecies</h2>
    if (Model.SpeciesRow is { } speciesRow) {
        <partial name="_RelatedTaxaTable" model="@(new[] { speciesRow })" />
    } else {
        <p>@SiteText.SpeciesNotAssessedBefore<span class="sci-name"><i>@Model.UnassessedSpeciesName</i></span>@SiteText.SpeciesNotAssessedAfter</p>
    }
    if (Model.RelatedTaxa.Count > 0) {
        var kinds = Model.RelatedTaxa.Select(r => r.Taxon.Kind).ToHashSet();
        <h3>@SiteText.HeadingOtherInfraTaxa(kinds.Contains(TaxonKinds.Subspecies), kinds.Contains(TaxonKinds.Variety), kinds.Contains(TaxonKinds.Subpopulation))</h3>
        <partial name="_RelatedTaxaTable" model="Model.RelatedTaxa" />
    }
}
</section>

@if (Model.GreenStatus is { } greenStatus) {
    <partial name="_GreenStatus" model="greenStatus" />
}

@if (Model.OtherStatusSection is { } otherStatuses) {<partial name="_OtherStatuses" model="otherStatuses" />}

<partial name="_TaxonNames" model="Model.Names" />
@if (Model.SubspeciesList is { } subspeciesList) {<partial name="_Subspecies" model="subspeciesList" />}

@if (Model.ComparativeClassification.Count > 0) {
    var differences = Model.ComparativeClassification.Sum(r => r.Cells.Count(c => c.Differs));
    var aboveRows = Model.ComparativeClassification.Where(r => r.AboveCut).ToList();
    var firstShown = Model.ComparativeClassification.FirstOrDefault(r => !r.AboveCut)?.RankLabel ?? "";
    <section class="comparative-classification" id="comparative-classification" aria-labelledby="comparative-classification-heading">
        <h2 id="comparative-classification-heading">@SiteText.HeadingComparativeClassification</h2>
        <p>@SiteText.RanksIntro(differences)</p>
        @if (aboveRows.Count > 0) {
            <p class="ranks-toggle"><label><input type="checkbox" class="show-above-ranks" autocomplete="off"> @SiteText.RanksShowAbove(aboveRows.Count, firstShown, aboveRows.Sum(r => r.Cells.Count(c => c.Differs)))</label></p>
        }
        <div class="table-scroll">
            <table class="ranks-table" aria-labelledby="comparative-classification-heading">
                <thead>
                    <tr>
                        <td></td>
                        @foreach (var column in Model.RankColumns) {
                            <th scope="col" title="@column.Help">@if (column.Url is { } url) {<a href="@url">@column.Title</a>} else {@column.Title}</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.ComparativeClassification) {
                        var rowClass = row.AboveCut ? (row.IsMain ? "main-rank above-rank" : "above-rank") : row.IsMain ? "main-rank" : null;
                        <tr class="@rowClass">
                            <th scope="row">@SiteText.RankRowLabel(row.RankLabel)</th>
                            @foreach (var cell in row.Cells) {
                                <td class="@(cell.Differs ? "differs" : null)">
                                    @if (cell.Step is { } step) {
                                        @if (step.Url is { } u) {<a href="@u">@Html.Raw(ScientificNameMarkup.ToHtml(step.Name))</a>} else {@Html.Raw(ScientificNameMarkup.ToHtml(step.Name))}
                                        @if (cell.Differs) {
                                            <abbr class="differs-marker" title="@SiteText.RanksDiffersTitle">≠</abbr>
                                        }
                                        @* Another rank than the row's goes under the name, so the names stay in line. *@
                                        @if (cell.OtherRank) {
                                            <span class="rank other-rank">@(step.Rank ?? SiteText.RanksNoRank)</span>
                                        }
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@if (Model.ExtraPairs.Count > 0) {
    <section class="extra-pairs-section" id="duplicates" aria-labelledby="pairs-heading">
        <h2 id="pairs-heading">@SiteText.TaxonExtraPairsHeading</h2>
        <p>@SiteText.TaxonExtraPairsIntro</p>
        <partial name="_ExtraPairs" model="Model.ExtraPairs" />
    </section>
}

<section class="links" aria-labelledby="links-heading">
    <h2 id="links-heading">@SiteText.HeadingLinks</h2>
    <dl class="facts">
        <dt>@SiteText.LinkWikipedia</dt>
        <dd>
            @if (taxon.EnwikiTitle is not null) {
                <a href="@SiteFormat.WikipediaUrl(taxon.EnwikiTitle)">@taxon.EnwikiTitle</a>
            } else {
                @SiteText.LinkWikipediaNone
            }
        </dd>
        @if (Model.TaxoboxCheck is { } check) {
            <dt>@SiteText.TaxoboxStatusHeading</dt>
            <dd class="taxobox-status"><partial name="_TaxoboxStatus" model="@(new TaxoboxStatusView(check, Model.LatestGlobal))" /></dd>
        }
        @if (taxon.WikidataQid is not null) {
            <dt>@SiteText.LinkWikidata</dt>
            <dd><a href="@SiteFormat.WikidataUrl(taxon.WikidataQid)">@taxon.WikidataQid</a></dd>
        }
        @if (Model.WikispeciesTitle is { } wikispeciesTitle) {
            <dt>@SiteText.LinkWikispecies</dt>
            <dd><a href="@SiteFormat.WikispeciesUrl(wikispeciesTitle)">@Html.Raw(ScientificNameMarkup.ToHtml(wikispeciesTitle))</a></dd>
        }
        @if (Model.CommonsGallery is not null || Model.CommonsCategory is not null) {
            <dt>@SiteText.LinkCommons</dt>
            <dd>@if (Model.CommonsGallery is { } gallery) {<a href="@BeastieBot3.Shared.SiteData.ExternalDatabases.CommonsUrl(gallery)">@gallery</a>}@if (Model.CommonsGallery is not null && Model.CommonsCategory is not null) {<text> · </text>}@if (Model.CommonsCategory is { } category) {<a href="@BeastieBot3.Shared.SiteData.ExternalDatabases.CommonsUrl(category)">@category</a>}</dd>
        }
        @if (taxon.ColId is not null) {
            <dt>@SiteText.LinkCol</dt>
            <dd><a href="@SiteFormat.CatalogueOfLifeUrl(taxon.ColId)">@Html.Raw(ScientificNameMarkup.ToHtml(taxon.ScientificName, taxon.SubpopulationName))</a></dd>
        }
        @if (Model.EpbcListings.Count > 0) {
            <dt><abbr title="@SiteText.SpratFullName">@(Model.EpbcListings.Count == 1 ? SiteText.LinkSprat : SiteText.LinkSpratPlural)</abbr></dt>
            <dd>
                <ul class="sprat-profiles">
                    @foreach (var listing in Model.EpbcListings) {
                        var nameHtml = ScientificNameMarkup.ToHtml(taxon.ScientificName, taxon.SubpopulationName);
                        if (listing.IsPopulation && listing.Population is { } population) {
                            nameHtml += " (" + SiteHtml.Encode(population) + ")";
                        }
                        <li><a href="@SiteFormat.SpratUrl(listing.SpratTaxonId)">@Html.Raw(nameHtml)</a></li>
                    }
                </ul>
            </dd>
        }
        @if (Model.ExternalLinks.Count > 0) {
            <dt>@SiteText.LinkOtherDatabases</dt>
            <dd class="external-links">
                @for (var i = 0; i < Model.ExternalLinks.Count; i++) {
                    <a href="@Model.ExternalLinks[i].Url">@Model.ExternalLinks[i].Name</a>@(i < Model.ExternalLinks.Count - 1 ? " · " : "")
                }
            </dd>
        }
    </dl>
</section>

<section class="tools" id="tools" aria-labelledby="tools-heading">
    <h2 id="tools-heading">@SiteText.HeadingTools</h2>
    <ul class="tool-links">
        <li><a href="@SpeciesWikitextModel.PathFor(taxon.TaxonId)">@SiteText.ToolWikitextFor<span class="sci-name">@Html.Raw(ScientificNameMarkup.ToHtml(taxon.ScientificName, taxon.SubpopulationName))</span></a> <span class="help">@SiteText.ToolWikitextHelp</span></li>
        @if (Model.GenusGroup is { } genus) {
            <li><a href="@BeastieBot3.Site.Web.SiteUrls.GroupList(genus)">@GroupText.ToolListLinkBefore<partial name="_GroupInSentence" model="genus" /></a> <span class="help">@GroupText.ToolListHelp(genus)</span></li>
        }
        <li><a href="/update">@SiteText.ToolUpdateLink</a> <span class="help">@SiteText.ToolUpdateHelp</span></li>
    </ul>
</section>
