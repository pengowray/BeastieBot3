@page "/species/{taxonId:long}"
@model SpeciesModel
@{
    var taxon = Model.Taxon;
    if (taxon is null) {
        ViewData["Title"] = SiteText.TaxonNotFoundHeading(Model.RequestedTaxonId);
        ViewData["HideHeaderSearch"] = true;
    } else {
        ViewData["Title"] = taxon.CommonNameEn is null ? taxon.ScientificName : $"{taxon.ScientificName} ({taxon.CommonNameEn})";
    }
}
@if (taxon is null) {
    <h1>@SiteText.TaxonNotFoundHeading(Model.RequestedTaxonId)</h1>
    <p>@(Model.Version is null ? SiteText.TaxonNotFoundLineNoVersion : SiteText.TaxonNotFoundLine(Model.Version))</p>
    <partial name="_SearchForm" model="@(new SearchFormModel(null, "main"))" />
    return;
}
@{
    var status = Model.StatusAssessment;
    var selected = Model.Selected;
    var parentPrefix = SiteText.ParentLinePrefix(taxon.Kind);
    var ranks = new[] { taxon.Kingdom, taxon.Phylum, taxon.ClassName, taxon.OrderName, taxon.Family, taxon.Genus };
}

@if (Model.ArrivedQuery is { } arrived) {
    <p class="arrival">
        @if (!Model.ArrivedNameIsShown) {
            @(Model.ArrivedNameType == NameTypes.Synonym ? SiteText.ArrivedSynonym(arrived) : SiteText.ArrivedCommonName(arrived))
        }
        <a href="/search?q=@Uri.EscapeDataString(arrived)&amp;all=1">@SiteText.ArrivedAllResults(arrived)</a>
    </p>
}

<header class="taxon-header">
    <h1>
        <span class="sci-name">@Html.Raw(ScientificNameMarkup.ToHtml(taxon.ScientificName, taxon.SubpopulationName))</span>
        @if (!string.IsNullOrWhiteSpace(taxon.Authority)) {
            <span class="authority">@taxon.Authority</span>
        }
    </h1>
    @if (taxon.CommonNameEn is not null) {
        <p class="taxon-common-name">@taxon.CommonNameEn</p>
    }
    @if (parentPrefix is not null && Model.Parent is { } parent) {
        <p class="parent-line">@parentPrefix <a href="/species/@parent.TaxonId">@Html.Raw(ScientificNameMarkup.ToHtml(parent.ScientificName, parent.SubpopulationName))</a></p>
    }
    @if (Model.Classification.Count > 0) {
        var colCount = Model.Classification.Count(g => g.IsCol);
        @* The groups link to their pages. Catalogue of Life groups are hidden until the box is ticked
           (site.css, :has), so the page needs no script for it. *@
        <div class="classification has-col-toggle">
            <h2 id="classification-heading" class="visually-hidden">@SiteText.HeadingClassification</h2>
            <ol>
                @foreach (var step in Model.Classification) {
                    var colNames = step.CommonNameEn is null ? Model.ClassificationColNames.GetValueOrDefault(step.NodeId) : null;
                    <li class="@(step.IsCol ? "col-group" : null)">
                        @if (step.ShowRank && step.Rank != "unranked") {
                            <span class="rank">@BeastieBot3.Site.Lists.GroupList.Capitalize(step.Rank)</span>
                        }
                        <a href="@BeastieBot3.Site.Web.SiteUrls.Group(step)">@if (step.IsGenus) {<i>@step.Name</i>} else {@step.Name}</a>
                        @if (step.CommonNameEn is not null) {
                            <span class="group-common">@step.CommonNameEn</span>
                        } else if (colNames is { Count: > 0 }) {
                            <span class="group-common col-names" title="@GroupText.ColNamesTitle">@string.Join(", ", colNames.Take(3))</span>
                        }
                        @if (step.IsCol) {
                            <abbr class="col-marker" title="@GroupText.ColMarkerTitle">@GroupText.ColMarker</abbr>
                        } else if (step.IsFromRule) {
                            <span class="rule-marker" title="@GroupText.RuleMarkerTitle">@GroupText.RuleMarker</span>
                        }
                    </li>
                }
            </ol>
            @if (colCount > 0) {
                <label class="col-toggle"><input type="checkbox" class="show-col" autocomplete="off"> @GroupText.ShowColGroups (@colCount)</label>
            }
        </div>
    } else if (ranks.Any(r => !string.IsNullOrWhiteSpace(r))) {
        @* The ranks are plain text, so they sit in a div with a hidden heading (a nav landmark is for links). *@
        <div class="classification">
            <h2 id="classification-heading" class="visually-hidden">@SiteText.HeadingClassification</h2>
            <ol>
                @for (var i = 0; i < ranks.Length; i++) {
                    if (string.IsNullOrWhiteSpace(ranks[i])) {
                        continue;
                    }
                    var value = SiteFormat.TitleCase(ranks[i]!);
                    <li><span class="rank">@SiteText.RankLabels[i]</span> @if (i == ranks.Length - 1) {<i>@value</i>} else {<text>@value</text>}</li>
                }
            </ol>
        </div>
    }
</header>

<section class="status" aria-labelledby="status-heading">
    <h2 id="status-heading">@(Model.LatestGlobal is null ? SiteText.HeadingStatusNoGlobal : SiteText.HeadingStatus)</h2>
    @if (!Model.InRelease) {
        <p class="no-global-line">@SiteText.NoCurrentLine(Model.Version)</p>
        @foreach (var link in Model.LinkedTaxa) {
            var current = link.Taxon;
            var currentName = ScientificNameMarkup.ToHtml(current.ScientificName, current.SubpopulationName);
            if (link.IsSynonym) {
                <p class="current-taxon">@SiteText.SynonymOfBefore<span class="sci-name">@Html.Raw(ScientificNameMarkup.ToHtml(taxon.ScientificName, taxon.SubpopulationName))</span>@SiteText.SynonymOfMiddle<span class="sci-name">@Html.Raw(currentName)</span>@SiteText.SynonymOfBeforeLink<a href="/species/@current.TaxonId">@SiteText.IucnIdLink(current.TaxonId)</a>@SiteText.SynonymOfAfter</p>
            } else {
                <p class="current-taxon">@SiteText.CurrentTaxonBefore(Model.Version)<span class="sci-name">@Html.Raw(currentName)</span>@SiteText.CurrentTaxonMiddle<a href="/species/@current.TaxonId">@SiteText.IucnIdLink(current.TaxonId)</a>@SiteText.CurrentTaxonAfter</p>
            }
        }
    } else if (Model.LatestGlobal is null && Model.RegionalRows.Count > 0) {
        <p class="no-global-line">@SiteText.NoGlobalBefore<a href="#regional">@SiteText.NoGlobalLinkText(Model.RegionalRows.Count)</a>@SiteText.NoGlobalAfter</p>
    }
    @if (status is not null) {
        <dl class="facts">
            @if (!status.IsGlobal) {
                <dt>@SiteText.LabelRegion</dt>
                <dd>@status.Scope</dd>
            }
            <dt>@SiteText.LabelCategory</dt>
            <dd><partial name="_Badge" model="@BadgeModel.For(status, large: true)" /></dd>
            <dt>@SiteText.LabelCriteria</dt>
            <dd>@(string.IsNullOrWhiteSpace(status.Criteria) ? SiteText.CriteriaNone : status.Criteria)</dd>
            @if (!string.IsNullOrWhiteSpace(status.PopulationTrend)) {
                <dt>@SiteText.LabelTrend</dt>
                <dd>@status.PopulationTrend</dd>
            }
            @if (!string.IsNullOrWhiteSpace(status.AssessmentDate)) {
                <dt>@SiteText.LabelAssessed</dt>
                <dd>@SiteFormat.Date(status.AssessmentDate)</dd>
            }
            @if (status.YearPublished is { } published) {
                <dt>@SiteText.LabelPublished</dt>
                <dd>@published</dd>
            }
            @if (Model.Version is not null) {
                <dt>@SiteText.LabelVersion</dt>
                <dd>@Model.Version</dd>
            }
        </dl>
        <p class="iucn-link"><a href="@SiteFormat.IucnAssessmentUrl(status.TaxonId, status.AssessmentId)">@SiteText.IucnLink</a></p>
    }
</section>

@if (selected is not null) {
    <section class="wikitext" id="wikitext" aria-labelledby="wikitext-heading"
             data-copied="@SiteText.Copied" data-copy-label="@SiteText.Copy" data-copy-failed="@SiteText.CopyFailed" data-copy-failed-button="@SiteText.CopyFailedButton"
             data-live-updated="@SiteText.WikitextUpdated" data-live-too-many="@SiteText.WikitextTooManyRequests" data-options-url="@Model.CurrentOptionsUrl">
        <h2 id="wikitext-heading">@SiteText.HeadingWikitext</h2>
        @{
            var selectedCategory = IucnCategories.Describe(selected).Label;
        }
        @* site.js replaces each data-live-region element with the one of the same id when the
           citation options change. The form is never replaced, so it keeps focus and typing. *@
        <div class="wikitext-output" id="wikitext-output" data-live-region>
        @if (!selected.IsGlobal) {
            <p class="note note-selected">
                @SiteText.RegionalAssessment(selected.Scope, selectedCategory, selected.YearPublished, Model.VersionNote(selected))
                @SiteText.TaxoboxGlobalOnly(Model.Taxobox.Label)
                @if (Model.LatestGlobal is not null && Model.InRelease) {
                    <a href="@(Model.OptionsUrl(null))#wikitext">@SiteText.ShowLatestWikitext</a>
                }
            </p>
        } else if (!Model.SelectedIsDefault) {
            <p class="note note-selected">
                @SiteText.EarlierAssessment(selectedCategory, selected.YearPublished, Model.VersionNote(selected))
                @if (Model.StatusAssessment is not null) {
                    <a href="@(Model.OptionsUrl(null))#wikitext">@SiteText.ShowLatestWikitext</a>
                }
            </p>
        }
        @if (IucnCategories.IsEarlierVersionCode(selected)) {
            <p class="note">@SiteText.NoTemplateEarlierVersion(Model.Taxobox.Name)</p>
        } else if (!IucnCategories.HasStatusTemplateCode(selected)) {
            <p class="note">@SiteText.NoTemplateCode(Model.Taxobox.Noun)</p>
        }

        @if (Model.Parts is null) {
            <p class="note">
                @SiteText.NoCitationReason
                @if (IucnCategories.HasStatusTemplateCode(selected)) {
                    @SiteText.NoCitationStatusAvailable
                }
                @SiteText.NoCitationBefore<a href="@SiteFormat.IucnAssessmentUrl(selected.TaxonId, selected.AssessmentId)">@SiteText.NoCitationLink</a>@SiteText.NoCitationAfter
            </p>
        }

        @foreach (var box in Model.Boxes) {
            <div class="wikitext-box">
                <partial name="_WikitextBoxContent" model="box" />
                @if (box.Id == "wikitext-cite") {
                    <div class="citation-notes">
                        @if (Model.DoiNote is not null) {
                            <p class="note">@Model.DoiNote</p>
                        }
                        @if (Model.UnsplitAuthors.Count > 0) {
                            <p class="note">@SiteText.AuthorsUnsplit @string.Join("; ", Model.UnsplitAuthors)</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Parts?.IucnCitationText)) {
                            <details class="iucn-citation" id="iucn-citation">
                                <summary>@SiteText.IucnCitationLabel</summary>
                                <p>@Model.Parts.IucnCitationText</p>
                            </details>
                        }
                    </div>
                }
            </div>
        }
        </div>

        @if (Model.Parts is not null) {
            <form class="options-form" method="get" action="/species/@taxon.TaxonId#wikitext">
                <fieldset>
                    <legend>@SiteText.OptionsLegend</legend>
                    <input type="hidden" name="opts" value="1">
                    @if (!Model.SelectedIsDefault) {
                        <input type="hidden" name="assessment" value="@selected.AssessmentId">
                    }
                    <fieldset class="option-group">
                        <legend>@SiteText.AuthorsLabel</legend>
                        <label><input type="radio" name="authors" value="author" checked="@(Model.Options.AuthorStyle == CiteAuthorStyle.AuthorN)"> @Html.Raw(SiteText.AuthorsAuthorHtml)</label>
                        <label><input type="radio" name="authors" value="lastfirst" checked="@(Model.Options.AuthorStyle == CiteAuthorStyle.LastFirst)"> @Html.Raw(SiteText.AuthorsLastFirstHtml)</label>
                        @if (Model.GivenNames is { } given) {
                            <label class="option-extra"><input type="checkbox" name="fullnames" value="1" checked="@Model.Options.FullGivenNames" aria-describedby="fullnames-help"> @SiteText.FullGivenNames</label>
                            <p class="help" id="fullnames-help">@SiteText.FullGivenNamesHelp(given.WithGivenNames, given.People, given.Example.GivenNames!.Trim(), given.Example.Display.Trim())</p>
                        } else if (Model.Options.FullGivenNames) {
                            @* Kept for the next assessment shown, which may have full given names. *@
                            <input type="hidden" name="fullnames" value="1">
                        }
                    </fieldset>
                    <fieldset class="option-group">
                        <legend>@SiteText.AccessLabel</legend>
                        @if (Model.DownloadDateText is not null) {
                            <label><input type="radio" name="access" value="download" checked="@(Model.Options.Access == WikitextOptions.AccessDownload)" aria-describedby="access-help"> @SiteText.AccessDownload(Model.DownloadDateText)</label>
                        }
                        <label><input type="radio" name="access" value="today" checked="@(Model.Options.Access == WikitextOptions.AccessToday)"> @SiteText.AccessToday(Model.TodayText)</label>
                        <label><input type="radio" name="access" value="none" checked="@(Model.Options.Access == WikitextOptions.AccessNone || (Model.DownloadDateText is null && Model.Options.Access == WikitextOptions.AccessDownload))"> @SiteText.AccessNone</label>
                        @if (Model.DownloadDateText is not null) {
                            <p class="help" id="access-help">@SiteText.AccessHelp</p>
                        }
                    </fieldset>
                    <div class="option-group">
                        <label><input type="checkbox" name="ref" value="1" checked="@Model.Options.WrapInRef"> @Html.Raw(SiteText.RefWrapHtml)</label>
                        <label class="ref-name">@SiteText.RefName <input type="text" name="refname" value="@Model.Options.RefName" maxlength="@WikitextOptions.MaxRefNameLength" size="20" spellcheck="false" aria-describedby="refname-help"></label>
                        <p class="help" id="refname-help">@SiteText.RefNameHelp</p>
                    </div>
                    <div class="option-group">
                        <label><input type="checkbox" name="amp" value="1" checked="@Model.Options.Amp" aria-describedby="amp-help"> @Html.Raw(SiteText.AmpHtml)</label>
                        <p class="help" id="amp-help">@SiteText.AmpHelp</p>
                    </div>
                    @* site.js hides the button and updates the wikitext as soon as an option changes,
                       saying so in the status line. *@
                    <button type="submit">@SiteText.UpdateWikitext</button>
                    <p class="live-status" role="status" data-live-status hidden></p>
                </fieldset>
            </form>
        }

        @if (Model.Wikidata is { } wikidata) {
            <section class="wikidata-cite" id="wikidata-cite" aria-labelledby="wikidata-cite-heading" data-live-region>
                <h3 id="wikidata-cite-heading">@SiteText.HeadingWikidataCite</h3>
                @if (wikidata.ItemQid is { } itemQid) {
                    <p class="wikidata-item">@SiteText.WikidataItemBefore<a href="@wikidata.ItemUrl">@itemQid</a></p>
                    @if (wikidata.CiteQ is { } citeQ) {
                        <div class="wikitext-box">
                            <partial name="_WikitextBoxContent" model="citeQ" />
                        </div>
                        <p class="note"><a href="@SiteText.CiteQGuidanceUrl">@SiteText.CiteQGuidanceLink</a>@SiteText.CiteQGuidanceAfter</p>
                    }
                    @if (wikidata.ItemIsForAssessmentId is { } owner) {
                        @if (wikidata.ItemAssessmentHasPage) {
                            <p class="wikidata-borrowed">@SiteText.BorrowedItemBefore<a href="@(Model.OptionsUrl(owner))#wikidata-cite">@SiteText.BorrowedItemLink</a>.</p>
                        } else {
                            <p class="wikidata-borrowed">@SiteText.BorrowedItemNoPage(owner)</p>
                        }
                    }
                    <partial name="_WikidataName" model="wikidata" />
                    @if (wikidata.Commands is { } add) {
                        var changes = wikidata.Changes;
                        @if (changes.Count == 0) {
                            <p class="wikidata-missing">@SiteText.MissingStatements(string.Join(", ", wikidata.AddedStatements)) @SiteText.AddStatementsLine</p>
                        } else {
                            @if (wikidata.AddedStatements.Count > 0) {
                                <p class="wikidata-missing">@SiteText.MissingStatements(string.Join(", ", wikidata.AddedStatements))</p>
                            }
                            <partial name="_WikidataItemChanges" model="wikidata" />
                            <p>@SiteText.RunCommandsLine</p>
                        }
                        <partial name="_WikidataMainSubject" model="wikidata" />
                        <div class="wikitext-box">
                            <partial name="_WikitextBoxContent" model="add" />
                        </div>
                        @if (wikidata.QuickStatementsUrl is { } addUrl) {
                            <p class="quickstatements-link"><a href="@addUrl">@SiteText.OpenInQuickStatements</a></p>
                        }
                    }
                } else {
                    <p class="wikidata-item">@SiteText.NoWikidataItem</p>
                    @if (wikidata.NoUsableName && wikidata.CitationName is { } internalName) {
                        <p>@SiteText.NoUsableName(internalName)</p>
                    }
                    @if (wikidata.Commands is { } create) {
                        <p>
                            @if (wikidata.SearchUrl is { } searchUrl) {
                                @SiteText.SearchWikidataBefore<a href="@searchUrl">@SiteText.SearchWikidataLink</a>@SiteText.SearchWikidataAfter
                            }
                            @SiteText.CreateItemLine
                        </p>
                        <partial name="_WikidataName" model="wikidata" />
                        <partial name="_WikidataMainSubject" model="wikidata" />
                        <div class="wikitext-box">
                            <partial name="_WikitextBoxContent" model="create" />
                        </div>
                        @if (wikidata.QuickStatementsUrl is { } createUrl) {
                            <p class="quickstatements-link"><a href="@createUrl">@SiteText.OpenInQuickStatements</a></p>
                        }
                    }
                }
            </section>
        }
        @if (Model.WikidataStatus is { HasContent: true } wikidataStatus && Model.LatestGlobal is { } latestGlobal) {
            <partial name="_WikidataStatus" model="@(new WikidataStatusPartial(wikidataStatus, latestGlobal, Model.Version))" />
        }
    </section>
}

@if (Model.Combined is not null) {
    <partial name="_CombinedHistory" model="Model" />
} else if (Model.GlobalHistory.Count > 0) {
    <section class="history" aria-labelledby="history-heading">
        <h2 id="history-heading">@SiteText.HeadingHistory</h2>
        <div class="table-scroll">
            <table>
                <thead>
                    <tr>
                        <th scope="col">@SiteText.ColPublished</th>
                        <th scope="col">@SiteText.ColCategory</th>
                        <th scope="col">@SiteText.ColCriteria</th>
                        <th scope="col" class="narrow-hide">@SiteText.ColAssessed</th>
                        <th scope="col">@SiteText.ColWikitext</th>
                        <th scope="col">@SiteText.ColAssessment</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.GlobalHistory) {
                        var isShown = selected?.AssessmentId == a.AssessmentId;
                        var isLatest = a.AssessmentId == Model.LatestGlobal?.AssessmentId;
                        var versionNote = Model.VersionNote(a);
                        <tr class="@(isShown ? "shown" : null)">
                            <th scope="row">@a.YearPublished @if (isLatest) {<span class="tag">@SiteText.Latest</span>}@if (versionNote is not null) {<text> </text><span class="version-note">@versionNote</span>}</th>
                            <td><partial name="_Badge" model="@BadgeModel.For(a)" /></td>
                            <td>@a.Criteria</td>
                            <td class="narrow-hide">@SiteFormat.Date(a.AssessmentDate)</td>
                            <td>
                                @if (isShown) {
                                    <span class="shown-label">@SiteText.Shown</span>
                                } else {
                                    <a data-options-link="@SpeciesModel.OptionsLinkKey(isLatest ? null : a.AssessmentId)" href="@(Model.OptionsUrl(isLatest ? null : a.AssessmentId))#wikitext" aria-label="@SiteText.ShowWikitextAccessible(null, a.YearPublished, versionNote)">@SiteText.ShowWikitext</a>
                                }
                            </td>
                            <td><a href="@SiteFormat.IucnAssessmentUrl(a.TaxonId, a.AssessmentId)">@SiteText.IucnSiteLink</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_EarlierIds" model="Model" />
    </section>
} else if (Model.InRelease && Model.LinkedTaxa.Count > 0) {
    <section class="history" aria-labelledby="history-heading">
        <h2 id="history-heading">@SiteText.HeadingHistory</h2>
        <partial name="_EarlierIds" model="Model" />
    </section>
}

@if (Model.RegionalRows.Count > 0) {
    <section class="regional" id="regional" aria-labelledby="regional-heading">
        <h2 id="regional-heading">@SiteText.HeadingRegional</h2>
        <div class="table-scroll">
            <table>
                <thead>
                    <tr>
                        <th scope="col">@SiteText.ColRegion</th>
                        <th scope="col">@SiteText.ColCategory</th>
                        <th scope="col">@SiteText.ColCriteria</th>
                        <th scope="col">@SiteText.ColPublished</th>
                        <th scope="col">@SiteText.ColWikitext</th>
                        <th scope="col">@SiteText.ColAssessment</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.RegionalRows) {
                        var isShown = selected?.AssessmentId == a.AssessmentId;
                        var isDefault = a.AssessmentId == Model.StatusAssessment?.AssessmentId;
                        var versionNote = Model.VersionNote(a);
                        <tr class="@(isShown ? "shown" : null)">
                            <th scope="row">@a.Scope</th>
                            <td><partial name="_Badge" model="@BadgeModel.For(a)" /></td>
                            <td>@a.Criteria</td>
                            <td>@a.YearPublished@if (versionNote is not null) {<text> </text><span class="version-note">@versionNote</span>}</td>
                            <td>
                                @if (isShown) {
                                    <span class="shown-label">@SiteText.Shown</span>
                                } else {
                                    <a data-options-link="@SpeciesModel.OptionsLinkKey(isDefault ? null : a.AssessmentId)" href="@(Model.OptionsUrl(isDefault ? null : a.AssessmentId))#wikitext" aria-label="@SiteText.ShowWikitextAccessible(a.Scope, a.YearPublished, versionNote)">@SiteText.ShowWikitext</a>
                                }
                            </td>
                            <td><a href="@SiteFormat.IucnAssessmentUrl(a.TaxonId, a.AssessmentId)">@SiteText.IucnSiteLink</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

<section class="names" aria-labelledby="names-heading">
    <h2 id="names-heading">@SiteText.HeadingNames</h2>
    <h3>@SiteText.NamesEnglish</h3>
    @if (Model.EnglishNames.Count == 0) {
        <p>@SiteText.NoEnglishName</p>
    } else {
        <div class="table-scroll">
            <table class="names-table">
                <thead>
                    <tr>
                        <th scope="col">@SiteText.ColName</th>
                        <th scope="col">@SiteText.ColSource</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var n in Model.EnglishNames) {
                        <tr>
                            <th scope="row">@n.Name @if (n.IsIucnMain) {<span class="tag">@SiteText.IucnMainName</span>}</th>
                            <td>@string.Join(", ", n.Sources)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (Model.OtherLanguages.Count > 0) {
        <h3>@SiteText.NamesOtherLanguages</h3>
        var visibleGroups = Model.OtherLanguages.Take(SpeciesModel.ShortListLength).ToList();
        var hiddenGroups = Model.OtherLanguages.Skip(SpeciesModel.ShortListLength).ToList();
        <dl class="language-names">
            @foreach (var g in visibleGroups) {
                <dt>@g.Language</dt>
                <dd lang="@g.Lang">@string.Join(", ", g.Names)</dd>
            }
        </dl>
        @if (hiddenGroups.Count > 0) {
            <details>
                <summary>@SiteText.ShowMoreLanguages(hiddenGroups.Count)</summary>
                <dl class="language-names">
                    @foreach (var g in hiddenGroups) {
                        <dt>@g.Language</dt>
                        <dd lang="@g.Lang">@string.Join(", ", g.Names)</dd>
                    }
                </dl>
            </details>
        }
    }

    @if (Model.Synonyms.Count > 0) {
        <h3>@SiteText.NamesSynonyms</h3>
        <ul class="synonyms">
            @foreach (var s in Model.Synonyms.Take(SpeciesModel.ShortListLength)) {
                <li>@Html.Raw(ScientificNameMarkup.ToHtml(s))</li>
            }
        </ul>
        @if (Model.Synonyms.Count > SpeciesModel.ShortListLength) {
            <details>
                <summary>@SiteText.ShowMoreSynonyms(Model.Synonyms.Count - SpeciesModel.ShortListLength)</summary>
                <ul class="synonyms">
                    @foreach (var s in Model.Synonyms.Skip(SpeciesModel.ShortListLength)) {
                        <li>@Html.Raw(ScientificNameMarkup.ToHtml(s))</li>
                    }
                </ul>
            </details>
        }
    }
</section>

<section class="links" aria-labelledby="links-heading">
    <h2 id="links-heading">@SiteText.HeadingLinks</h2>
    <dl class="facts">
        <dt>@SiteText.LinkWikipedia</dt>
        <dd>
            @if (taxon.EnwikiTitle is not null) {
                <a href="@SiteFormat.WikipediaUrl(taxon.EnwikiTitle)">@taxon.EnwikiTitle</a>
            } else {
                @SiteText.LinkWikipediaNone
            }
        </dd>
        @if (taxon.WikidataQid is not null) {
            <dt>@SiteText.LinkWikidata</dt>
            <dd><a href="@SiteFormat.WikidataUrl(taxon.WikidataQid)">@taxon.WikidataQid</a></dd>
        }
        @if (taxon.ColId is not null) {
            <dt>@SiteText.LinkCol</dt>
            <dd><a href="@SiteFormat.CatalogueOfLifeUrl(taxon.ColId)">@Html.Raw(ScientificNameMarkup.ToHtml(taxon.ScientificName, taxon.SubpopulationName))</a></dd>
        }
        @if (Model.EpbcListings.Count > 0) {
            <dt><abbr title="@SiteText.SpratFullName">@(Model.EpbcListings.Count == 1 ? SiteText.LinkSprat : SiteText.LinkSpratPlural)</abbr></dt>
            <dd>
                <ul class="sprat-profiles">
                    @foreach (var listing in Model.EpbcListings) {
                        var nameHtml = ScientificNameMarkup.ToHtml(taxon.ScientificName, taxon.SubpopulationName);
                        if (listing.IsPopulation && listing.Population is { } population) {
                            nameHtml += " (" + SiteHtml.Encode(population) + ")";
                        }
                        var listedUnderOtherName = Model.ListedUnderOtherName(listing);
                        <li>
                            <a href="@SiteFormat.SpratUrl(listing.SpratTaxonId)">@Html.Raw(nameHtml)</a>
                            @if (IucnCategories.EpbcLabel(listing.Status) is { } epbc) {
                                <span class="epbc-listing">@SiteText.EpbcBefore(epbc)<abbr title="@SiteText.EpbcFullName">@SiteText.EpbcAbbr</abbr>@SiteText.EpbcAfter
                                @if (listing.IsPopulation && listing.Population is { } listedPopulation) {
                                    @SiteText.EpbcPopulationOnly(listedPopulation)
                                } else if (listedUnderOtherName) {
                                    @SiteText.EpbcListedNameBefore<span class="sci-name">@Html.Raw(SpeciesModel.ListedNameHtml(listing.ListedName))</span>@SiteText.EpbcAfter
                                }</span>
                            }
                        </li>
                    }
                </ul>
            </dd>
        }
    </dl>
</section>

@if (Model.Children.Count > 0) {
    <section class="children" aria-labelledby="children-heading">
        <h2 id="children-heading">@SiteText.HeadingChildren(
            Model.Children.Any(c => c.Taxon.Kind == TaxonKinds.Subspecies),
            Model.Children.Any(c => c.Taxon.Kind == TaxonKinds.Variety),
            Model.Children.Any(c => c.Taxon.Kind == TaxonKinds.Subpopulation))</h2>
        <partial name="_TaxonList" model="Model.Children" />
    </section>
}

@if (Model.Version is not null) {
    <p class="data-note">
        @if (Model.DataDateRange is not null) {
            @SiteText.DataNoteBefore(Model.Version, Model.DataDateRange)
        } else {
            @SiteText.DataNoteBeforeNoDates(Model.Version)
        }<a href="/about">@SiteText.AboutPageLink</a>@SiteText.DataNoteAfter
    </p>
}
