@model BeastieBot3.Site.Update.ListScopeView
@using BeastieBot3.Site.Update
@using BeastieBot3.Site.Lists
@* The comparison of the taxa the text lists with their group (ListScope). Report only. The scope
   choice and the button belong to the update form, so they send the text again. *@
@{
    var r = Model.Scope;
    var placement = Model.Placement;
    var rebuilt = Model.Rebuild is { Refusal: RebuildRefusal.None };
    var missingSpeciesOnly = Model.MissingSpeciesOnly;
    // The missing taxa to copy: all of them, or the ones not put into the wikitext.
    var placing = placement is not null && Model.AddMissing;
    var toCopy = (placing ? placement!.Unplaced : r.Missing)?.Where(t => t.TaxonId > 0).ToList();
    var extraToCopy = placing ? placement!.Unplaced.Where(t => t.TaxonId < 0).ToList() : r.MissingExtra;
}
<section class="update-scope" aria-labelledby="scope-heading">
    @if (Model.Rebuild is { } rebuild) {
        @await Html.PartialAsync("_ListRebuild", Model)
    }
    <h3 id="scope-heading">@UpdateText.ScopeHeading(r.Scope)</h3>
    <p>@UpdateText.ScopeSummary(r, Model.AreaName)</p>
    @if (r.Categories is { } categories) {
        <p>@UpdateText.ScopeCategories(r, categories, Model.CategoriesFromTitle)</p>
    }
    @if (r.Infra > 0) {
        <p>@UpdateText.ScopeInfra(r)</p>
    }
    <p class="update-scope-choice">
        @if (r.Path.Count > 1) {
            <span class="choice">
            <label for="scope-choice">@UpdateText.ScopeChooseLabel</label>
            <select id="scope-choice" name="@UpdateModel.ScopeField" form="update-form">
                @foreach (var group in r.Path.Reverse()) {
                    <option value="@ListScope.Key(group)" selected="@(group.NodeId == r.Scope.NodeId)">@UpdateText.ScopeOption(group, r.ListedIn.GetValueOrDefault(group.NodeId))</option>
                }
            </select>
            </span>
        }
        <span class="choice">
        <label for="categories-choice">@UpdateText.CategoriesChooseLabel</label>
        <select id="categories-choice" name="@UpdateModel.CategoriesField" form="update-form">
            <option value="" selected="@(Model.Categories is null)">@UpdateText.CategoriesFromCodesOption</option>
            @foreach (var choice in BeastieBot3.Shared.Wikitext.ListCategories.Choices) {
                <option value="@choice.Key" selected="@(Model.Categories?.Key == choice.Key)">@choice.Label</option>
            }
        </select>
        </span>
        @if (Model.Areas is { } areas && r.Region is null) {
            var all = areas.All.ToList();
            <span class="choice">
            <label for="area-choice">@UpdateText.AreaChooseLabel</label>
            <select id="area-choice" name="@UpdateModel.AreaField" form="update-form">
                <option value="" selected="@(r.Area is null)">@UpdateText.AreaWholeGroupOption</option>
                <optgroup label="@UpdateText.AreaCountriesGroup">
                    @foreach (var a in all.Where(a => a.IsCountry).OrderBy(a => a.DisplayName, StringComparer.Ordinal)) {
                        <option value="@a.Code" selected="@(r.Area == a.Code)">@a.DisplayName</option>
                    }
                </optgroup>
                <optgroup label="@UpdateText.AreaPartsGroup">
                    @foreach (var a in all.Where(a => !a.IsCountry).OrderBy(a => a.DisplayName, StringComparer.Ordinal)) {
                        <option value="@a.Code" selected="@(r.Area == a.Code)">@UpdateText.AreaOption(a, areas)</option>
                    }
                </optgroup>
            </select>
            </span>
            <span class="choice">
            <label for="area-mode">@UpdateText.AreaModeLabel</label>
            <select id="area-mode" name="@UpdateModel.AreaModeField" form="update-form">
                @foreach (var mode in Enum.GetValues<BeastieBot3.Shared.Wikitext.AreaMode>()) {
                    <option value="@mode" selected="@(r.AreaMode == mode)">@UpdateText.AreaModeOption(mode)</option>
                }
            </select>
            </span>
        }
        <button type="submit" form="update-form">@UpdateText.ScopeChooseButton</button>
    </p>
    @if (r.Partial && r.Missing is null) {
        <p>@UpdateText.ScopePartial(r, Model.AreaName) <button type="submit" form="update-form" name="@UpdateModel.ListAnywayField" value="1">@UpdateText.ScopeListAnywayButton</button></p>
    } else if (r.Partial) {
        @* Asked for: kept on when the form is sent again (Compare, the Catalogue of Life button). *@
        <input type="hidden" name="@UpdateModel.ListAnywayField" value="1" form="update-form">
    }
    @if (r.Partial && Model.AddMissing) {
        <p>@UpdateText.AddMissingPartial</p>
    }
    @if (r.Missing is { } missing) {
        @if (missing.Count == 0) {
            <p>@UpdateText.MissingNone</p>
        } else {
            <h4>@UpdateText.MissingHeading(r.MissingTotal)</h4>
            @if (missing.Count < r.MissingTotal) {
                <p>@UpdateText.MissingCapped(missing.Count, r.MissingTotal)</p>
            }
            @if (Model.AreaName is { } areaName && r.MissingAreaRecords.Count > 0) {
                var noted = missing.Where(t => r.MissingAreaRecords.ContainsKey(t.TaxonId)).ToList();
                <h4>@UpdateText.MissingAreaNotesHeading(noted.Count)</h4>
                <p>@UpdateText.MissingAreaNotesIntro(noted.Select(t => r.MissingAreaRecords[t.TaxonId]), areaName)</p>
                <div class="table-scroll">
                    <table class="update-report">
                        <thead><tr><th scope="col">@UpdateText.ColumnTaxon</th><th scope="col">@UpdateText.ColumnLatestStatus</th><th scope="col" title="@UpdateText.ColumnInAreaHelp">@UpdateText.ColumnInArea(Model.AreaHeadingName!)</th></tr></thead>
                        <tbody>
                            @foreach (var t in noted) {
                                <tr>
                                    <td><a href="/species/@t.TaxonId">@Html.Raw(ScientificNameMarkup.ToHtml(t.ScientificName))</a></td>
                                    <td>@GroupList.StatusCode(t)</td>
                                    <td>@UpdateText.AreaRecordText(r.MissingAreaRecords[t.TaxonId])</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (Model.Epbc is { } epbc) {
                var listed = missing.Where(t => epbc.ContainsKey(t.TaxonId)).ToList();
                <p>@UpdateText.MissingEpbc(listed.Count, missing.Count)</p>
                @if (listed.Count > 0) {
                    <div class="table-scroll">
                        <table class="update-report">
                            <thead><tr><th scope="col">@UpdateText.ColumnTaxon</th><th scope="col">@UpdateText.ColumnLatestStatus</th><th scope="col">@UpdateText.ColumnEpbc</th></tr></thead>
                            <tbody>
                                @foreach (var t in listed) {
                                    <tr>
                                        <td><a href="/species/@t.TaxonId">@Html.Raw(ScientificNameMarkup.ToHtml(t.ScientificName))</a></td>
                                        <td>@GroupList.StatusCode(t)</td>
                                        <td>@UpdateText.Epbc(epbc[t.TaxonId])</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        }
    }
    @if (rebuilt && r.Missing is { Count: > 0 }) {
        <p>@UpdateText.RebuildAddsMissing(Model.RebuildChoices.Infra == BeastieBot3.Site.Lists.InfraMode.None && r.Missing.Any(t => t.Kind != BeastieBot3.Site.Data.TaxonKinds.Species))</p>
    }
    @if (!rebuilt && !r.Partial && (r.Missing?.Count > 0 || r.MissingExtra?.Count > 0)) {
        @* Off: a button that sends the text again with the option on. On: a ticked checkbox, so
           the option stays on when the form is sent again, and can be turned off. *@
        <p class="update-scope-add">
            @if (Model.AddMissing) {
                <label><input type="checkbox" name="@UpdateModel.AddMissingField" value="1" form="update-form" checked aria-describedby="scope-add-help"> @UpdateText.AddMissingOption(missingSpeciesOnly)</label>
            } else {
                <button type="submit" form="update-form" name="@UpdateModel.AddMissingField" value="1" aria-describedby="scope-add-help">@UpdateText.AddMissingButton(missingSpeciesOnly)</button>
            }
        </p>
        @if (UpdateText.AddMissingHelp(Model.Forms) is { Length: > 0 } addHelp) {
            <p class="help" id="scope-add-help">@addHelp</p>
        }
    }
    @if (placement is not null && Model.AddMissing) {
        @if (r.Missing is { Count: > 0 }) {
            <p>@UpdateText.AddMissingResult(placement.Placed.Count(p => p.Taxon.TaxonId > 0), r.MissingTotal)</p>
        }
        @if (r.MissingExtra is { Count: > 0 } extraMissing) {
            <p>@UpdateText.AddExtraResult(placement.Placed.Count(p => p.Taxon.TaxonId < 0), extraMissing.Count)</p>
        }
        var newHeadings = placement.Placed.Where(p => p.NewHeading && p.Heading is not null).Select(p => p.Heading!).Distinct().ToList();
        @if (newHeadings.Count > 0) {
            <p>@UpdateText.NewHeadings(newHeadings)</p>
        }
        @if (placement.Placed.Count > 0) {
            var headings = placement.Placed.Any(p => p.Heading is not null);
            <div class="table-scroll">
                <table class="update-report">
                    <thead><tr><th scope="col">@UpdateText.ColumnTaxon</th>@if (headings) {<th scope="col">@UpdateText.ColumnHeading</th>}<th scope="col">@UpdateText.ColumnPlacedNextTo</th><th scope="col">@UpdateText.ColumnLine</th></tr></thead>
                    <tbody>
                        @foreach (var p in placement.Placed) {
                            <tr>
                                <td>@if (p.Taxon.TaxonId > 0) {<a href="/species/@p.Taxon.TaxonId">@Html.Raw(ScientificNameMarkup.ToHtml(p.Taxon.ScientificName))</a>} else {@Html.Raw(ScientificNameMarkup.ToHtml(p.Taxon.ScientificName))}</td>
                                @if (headings) {<td>@(p.Heading is { } h ? p.NewHeading ? UpdateText.NewHeadingValue(h) : h : "")</td>}
                                <td>@UpdateText.PlacedNextTo(p.Before) @if (p.NeighbourTaxon is { } n) {<a href="/species/@n.TaxonId">@Html.Raw(ScientificNameMarkup.ToHtml(p.NeighbourName))</a>} else {@Html.Raw(ScientificNameMarkup.ToHtml(p.NeighbourName))}</td>
                                <td>@p.NeighbourLine.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        @if (placement.Unplaced.Count > 0) {
            <div class="table-scroll">
                <table class="update-report">
                    <thead><tr><th scope="col">@UpdateText.ColumnTaxon</th><th scope="col">@UpdateText.ColumnWhyNotAdded</th></tr></thead>
                    <tbody>
                        @foreach (var t in placement.Unplaced) {
                            <tr>
                                <td>@if (t.TaxonId > 0) {<a href="/species/@t.TaxonId">@Html.Raw(ScientificNameMarkup.ToHtml(t.ScientificName))</a>} else {@Html.Raw(ScientificNameMarkup.ToHtml(t.ScientificName))}</td>
                                <td>@UpdateText.UnplacedReasonText(placement.UnplacedReasons.GetValueOrDefault(t.TaxonId))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
    @if (toCopy is { Count: > 0 } copy) {
        <div class="wikitext-box">
            <div class="wikitext-box-head">
                <label for="scope-missing">@(placing ? UpdateText.UnplacedLinesLabel(copy.Count) : UpdateText.MissingLinesLabel)</label>
                <button type="button" class="copy-button" data-copy="scope-missing" aria-label="@UpdateText.CopyMissingAccessible" hidden>@SiteText.Copy</button>
                <p class="copy-status" role="status" aria-live="polite"></p>
            </div>
            <textarea id="scope-missing" class="update-readonly" readonly rows="8" spellcheck="false" autocapitalize="off" autocomplete="off" aria-describedby="scope-missing-help">@("\n" + ListScope.MissingLines(copy, r.Style))</textarea>
            <p class="help" id="scope-missing-help">@UpdateText.MissingLinesHelp</p>
        </div>
    }
    @if (r.Categories is null && r.Missing is not null) {
        <p class="update-scope-add">
            @if (Model.ExtraSpecies) {
                <label><input type="checkbox" name="@UpdateModel.ExtraSpeciesField" value="1" form="update-form" checked aria-describedby="scope-extra-option-help"> @UpdateText.ExtraSpeciesOption</label>
            } else {
                <button type="submit" form="update-form" name="@UpdateModel.ExtraSpeciesField" value="1" aria-describedby="scope-extra-option-help">@UpdateText.ExtraSpeciesButton</button>
            }
        </p>
        <p class="help" id="scope-extra-option-help">@UpdateText.ExtraSpeciesHelp</p>
    }
    @if (r.MissingExtra is { } extra) {
        @if (r.ExtraTotal == 0) {
            <p>@UpdateText.ExtraNoneExist(r.Scope)</p>
        } else if (extra.Count == 0) {
            <p>@UpdateText.ExtraNone(r.Scope)</p>
        } else {
            <h4>@UpdateText.ExtraHeading(extra.Count)</h4>
        }
    }
    @if (extraToCopy is { Count: > 0 } extraCopy) {
        <div class="wikitext-box">
            <div class="wikitext-box-head">
                <label for="scope-extra">@UpdateText.ExtraLinesLabel(extraCopy.Count)</label>
                <button type="button" class="copy-button" data-copy="scope-extra" aria-label="@UpdateText.CopyExtraAccessible" hidden>@SiteText.Copy</button>
                <p class="copy-status" role="status" aria-live="polite"></p>
            </div>
            <textarea id="scope-extra" class="update-readonly" readonly rows="6" spellcheck="false" autocapitalize="off" autocomplete="off" aria-describedby="scope-extra-help">@("\n" + ListScope.MissingLines(extraCopy, r.Style))</textarea>
            <p class="help" id="scope-extra-help">@UpdateText.ExtraLinesHelp</p>
        </div>
    }
    @if (Model.AreaName is { } notInName && r.NotInArea.Count > 0) {
        <h4>@UpdateText.NotInAreaHeading(r.NotInArea.Count, r.AreaMode, notInName)</h4>
        <div class="table-scroll">
            <table class="update-report">
                <thead><tr><th scope="col">@UpdateText.ColumnTaxon</th><th scope="col">@UpdateText.ColumnLatestStatus</th><th scope="col" title="@UpdateText.ColumnInAreaHelp">@UpdateText.ColumnInArea(Model.AreaHeadingName!)</th><th scope="col">@UpdateText.ColumnLines</th></tr></thead>
                <tbody>
                    @foreach (var m in r.NotInArea) {
                        <tr>
                            <td><a href="/species/@m.Member.Taxon.TaxonId">@Html.Raw(ScientificNameMarkup.ToHtml(m.Member.Taxon.ScientificName))</a></td>
                            <td>@m.Member.CurrentCode</td>
                            <td>@UpdateText.AreaRecordText(m.Record)</td>
                            <td>@UpdateText.LineNumbers(m.Member.Lines)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @if (r.Region is { } region && r.NotInRegion.Count > 0) {
        <h4>@UpdateText.NotInRegionHeading(r.NotInRegion.Count, region)</h4>
        @await Html.PartialAsync("_ListScopeMembers", new ListScopeMembersView(r.NotInRegion, Model.Epbc))
    }
    @if (r.OtherCategory.Count > 0) {
        <h4>@UpdateText.OtherCategoryHeading(r.OtherCategory.Count, r.Categories!)</h4>
        @if (Model.Removing is null) {
            @* Off: a button that sends the text again with every taxon ticked. On: a checkbox on
               each row, sent with the key of the text, so that unticking all of them means none. *@
            <p class="update-scope-add">
                <button type="submit" form="update-form" name="@UpdateModel.RemoveAllField" value="1" aria-describedby="scope-remove-help">@UpdateText.RemoveButton</button>
            </p>
            <p class="help" id="scope-remove-help">@UpdateText.RemoveHelp</p>
            @await Html.PartialAsync("_ListScopeMembers", new ListScopeMembersView(r.OtherCategory, Model.Epbc))
        } else {
            <input type="hidden" name="@UpdateModel.RemoveShownField" value="@Model.TextKey" form="update-form">
            <p>@UpdateText.RemoveResult(rebuilt ? Model.Rebuild!.Removed.Count : placement?.Removed.Count ?? 0, r.OtherCategory.Count)</p>
            @if (placement?.RemovedHeadings is { Count: > 0 } removedHeadings) {
                <p>@UpdateText.RemovedHeadings(removedHeadings)</p>
            }
            @await Html.PartialAsync("_ListScopeMembers", new ListScopeMembersView(r.OtherCategory, Model.Epbc) {
                Removing = Model.Removing,
                Kept = (rebuilt ? Model.Rebuild!.Kept : placement?.Kept)?.ToDictionary(k => k.Member.Taxon.TaxonId, k => k.Reason) ?? [],
            })
            <p class="update-scope-add"><span class="help">@UpdateText.RemoveInstruction</span> <button type="submit" form="update-form">@UpdateText.Submit</button></p>
        }
    }
    @if (r.Outside.Count > 0) {
        <h4>@UpdateText.OutsideHeading(r.Outside.Count, r.Scope)</h4>
        @await Html.PartialAsync("_ListScopeMembers", new ListScopeMembersView(r.Outside, Model.Epbc))
    }
    @if (Model.Rebuild is null && Model.Forms.ListLines && r.Missing is not null) {
        <h4>@UpdateText.RebuildHeading</h4>
        <p class="update-scope-add">
            <button type="submit" form="update-form" name="@UpdateModel.RebuildField" value="1" aria-describedby="scope-rebuild-help">@UpdateText.RebuildButton</button>
        </p>
        <div class="help update-rebuild-help" id="scope-rebuild-help">
            <p>@UpdateText.RebuildHelpIntro</p>
            <ul>
                @foreach (var (label, text) in UpdateText.RebuildHelpItems(r.Categories)) {
                    <li><strong>@label</strong> @text</li>
                }
            </ul>
        </div>
    }
    @if (r.Duplicates.Count > 0) {
        <h4>@UpdateText.DuplicatesHeading(r.Duplicates.Count)</h4>
        <div class="table-scroll">
            <table class="update-report">
                <thead><tr><th scope="col">@UpdateText.ColumnTaxon</th><th scope="col">@UpdateText.ColumnNames</th><th scope="col">@UpdateText.ColumnLines</th></tr></thead>
                <tbody>
                    @foreach (var d in r.Duplicates) {
                        <tr>
                            <td><a href="/species/@d.Taxon.TaxonId">@Html.Raw(ScientificNameMarkup.ToHtml(d.Taxon.ScientificName))</a></td>
                            <td>@string.Join(", ", d.Names)</td>
                            <td>@UpdateText.LineNumbers(d.Lines)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
