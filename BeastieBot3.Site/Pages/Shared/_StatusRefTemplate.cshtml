@model SpeciesWikitextModel
@* The citation template: {{cite iucn}}, or {{cite Q}} when the assessment has a Wikidata item. With
   {{cite Q}}, its box is shown below the {{cite iucn}} box and the taxobox status_ref uses it. *@
@{
    var template = Model.Options.Template;
    var hasItem = Model.Selected?.WikidataItemQid is { Length: > 0 };
}
<fieldset class="option-group">
    <legend>@SiteText.CitationTemplateLabel</legend>
    <label><input type="radio" name="@IucnReference.QueryKey" value="@IucnReference.CiteIucnValue" checked="@(template == ReferenceTemplate.CiteIucn)" aria-describedby="status-ref-help"> @SiteText.StatusRefTemplateIucn</label>
    <label><input type="radio" name="@IucnReference.QueryKey" value="@IucnReference.CiteQValue" checked="@(template == ReferenceTemplate.CiteQ)" aria-describedby="status-ref-help"> @SiteText.StatusRefTemplateQ</label>
    @if (!hasItem && Model.Selected is { } selected && Model.Taxon is { } taxon) {
        <p class="help">@SiteText.CiteQNoItemBefore<a href="@AssessmentToolModel.WikidataPath(taxon.TaxonId, Model.SelectedIsDefault ? "" : "?assessment=" + selected.AssessmentId)">@SiteText.CiteQNoItemLink</a>@SiteText.CiteQNoItemAfter</p>
    }
    <p class="help" id="status-ref-help">@SiteText.CitationTemplateHelp</p>
</fieldset>
