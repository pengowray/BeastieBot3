@model SpeciesModel
@* The citation template in the taxobox status_ref ({{cite iucn}} or {{cite Q}}), shown when the
   page has taxobox status lines; otherwise the choice is kept for the next assessment shown. *@
@{
    var template = Model.Options.Template;
    var hasItem = Model.Selected?.WikidataItemQid is { Length: > 0 };
}
@if (Model.Boxes.Any(b => b.Id == "wikitext-speciesbox")) {
    <fieldset class="option-group">
        <legend>@SiteText.StatusRefTemplateLabel</legend>
        <label><input type="radio" name="@IucnReference.QueryKey" value="@IucnReference.CiteIucnValue" checked="@(template == ReferenceTemplate.CiteIucn)" aria-describedby="status-ref-help"> @SiteText.StatusRefTemplateIucn</label>
        <label><input type="radio" name="@IucnReference.QueryKey" value="@IucnReference.CiteQValue" checked="@(template == ReferenceTemplate.CiteQ)" aria-describedby="status-ref-help"> @SiteText.StatusRefTemplateQ</label>
        @if (!hasItem) {
            <p class="help">@SiteText.StatusRefNoItem</p>
        }
        <p class="help" id="status-ref-help">@SiteText.StatusRefTemplateHelp</p>
    </fieldset>
} else if (template == ReferenceTemplate.CiteQ) {
    <input type="hidden" name="@IucnReference.QueryKey" value="@IucnReference.CiteQValue">
}
