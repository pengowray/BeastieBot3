@model WikidataCiteView
@* The name in the assessment item's title and label, when it is not IUCN's citation name, or when
   the commands use IUCN's citation name because the published name is not known
   (WikidataCiteView.ShowNameNote). *@
@if (Model.ShowNameNote && Model.Name is { } name && Model.CitationName is { } cited) {
    <p class="wikidata-name">
        @switch (name.Source) {
            case PublishedNameSource.ItemTitle:
                @SiteText.NameFromItemTitle(name.Name, cited)
                break;
            case PublishedNameSource.Crossref:
                @SiteText.NameRegistered(name.Name, cited)
                break;
            default:
                @SiteText.NameFromIucnCitation(cited)
                break;
        }
        @if (Model.CommandsUseName && name.Source != PublishedNameSource.IucnCitation) {
            @(" ")@SiteText.NameCommandsUsePublished
        }
    </p>
}
