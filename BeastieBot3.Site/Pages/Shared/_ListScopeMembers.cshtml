@model BeastieBot3.Site.Update.ListScopeMembersView
@* The status in the wikitext is shown only when some rows have one; the EPBC Act listing when
   the reader asked for it. *@
@{
    var written = Model.Members.Any(m => m.WrittenCode is not null);
    var epbc = Model.Epbc;
}
<div class="table-scroll">
    <table class="update-report">
        <thead><tr><th scope="col">@UpdateText.ColumnTaxon</th>@if (written) {<th scope="col">@UpdateText.ColumnStatusInWikitext</th>}<th scope="col">@UpdateText.ColumnLatestStatus</th>@if (epbc is not null) {<th scope="col">@UpdateText.ColumnEpbc</th>}<th scope="col">@UpdateText.ColumnLines</th></tr></thead>
        <tbody>
            @foreach (var m in Model.Members) {
                <tr>
                    <td><a href="/species/@m.Taxon.TaxonId">@Html.Raw(ScientificNameMarkup.ToHtml(m.Taxon.ScientificName))</a></td>
                    @if (written) {<td>@m.WrittenCode</td>}
                    <td>@m.CurrentCode</td>
                    @if (epbc is not null) {<td>@UpdateText.Epbc(epbc.GetValueOrDefault(m.Taxon.TaxonId))</td>}
                    <td>@UpdateText.LineNumbers(m.Lines)</td>
                </tr>
            }
        </tbody>
    </table>
</div>
