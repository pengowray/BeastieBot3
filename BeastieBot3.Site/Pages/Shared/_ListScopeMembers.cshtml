@model IReadOnlyList<BeastieBot3.Site.Update.ListScopeMember>
@* The status in the wikitext is shown only when some rows have one. *@
@{
    var written = Model.Any(m => m.WrittenCode is not null);
}
<div class="table-scroll">
    <table class="update-report">
        <thead><tr><th scope="col">@UpdateText.ColumnTaxon</th>@if (written) {<th scope="col">@UpdateText.ColumnStatusInWikitext</th>}<th scope="col">@UpdateText.ColumnLatestStatus</th><th scope="col">@UpdateText.ColumnLines</th></tr></thead>
        <tbody>
            @foreach (var m in Model) {
                <tr>
                    <td><a href="/species/@m.Taxon.TaxonId">@Html.Raw(ScientificNameMarkup.ToHtml(m.Taxon.ScientificName))</a></td>
                    @if (written) {<td>@m.WrittenCode</td>}
                    <td>@m.CurrentCode</td>
                    <td>@UpdateText.LineNumbers(m.Lines)</td>
                </tr>
            }
        </tbody>
    </table>
</div>
