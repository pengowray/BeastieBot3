@using BeastieBot3.Shared.Wikitext
@using BeastieBot3.Site.Lists
@model ListLineOptions
@* The bullet list options for the taxon authority and the references after each line (ListLineOptions:
   auth, lrefs, lcite). The keys differ from the species tables' refs and cite, which are in the same form. *@
<fieldset class="option-group" aria-labelledby="legend-authority">
    <legend><span id="legend-authority">@GroupLineText.AuthorityLegend</span> <partial name="_InfoTip" model="@(new InfoTipModel("tip-authority", GroupText.InfoTipLabel(GroupLineText.AuthorityLegend), GroupLineText.AuthorityHelp))" /></legend>
    @foreach (var (value, label, example) in new[] {
                 (SpeciesListAuthority.None, GroupLineText.AuthorityNone, (string?)null),
                 (SpeciesListAuthority.Small, GroupLineText.AuthoritySmall, GroupLineText.AuthoritySmallExample),
                 (SpeciesListAuthority.Plain, GroupLineText.AuthorityPlain, GroupLineText.AuthorityPlainExample),
             }) {
        <label>
            <input type="radio" name="auth" value="@ListLineOptions.AuthorityKey(value)" checked="@(Model.Authority == value)">
            @label
            @if (example is not null) {
                <span class="example">@example</span>
            }
        </label>
    }
</fieldset>
<fieldset class="option-group" aria-labelledby="legend-line-references">
    <legend><span id="legend-line-references">@GroupText.OptionReferences</span> <partial name="_InfoTip" model="@(new InfoTipModel("tip-line-references", GroupText.InfoTipLabel(GroupText.OptionReferences), GroupLineText.ReferencesHelp + " " + GroupLineText.ReferencesWikidataHelp))" /></legend>
    @foreach (var (value, label) in new[] {
                 (ListReferenceMode.None, GroupText.ReferencesNone),
                 (ListReferenceMode.ListDefined, GroupText.ReferencesListDefined),
                 (ListReferenceMode.Inline, GroupLineText.ReferencesInline),
             }) {
        <label><input type="radio" name="lrefs" value="@ListLineOptions.ReferencesKey(value)" checked="@(Model.References == value)"> @label</label>
    }
    <p class="option-sublabel">@GroupText.OptionCitationTemplate</p>
    <label><input type="radio" name="lcite" value="@IucnReference.CiteIucnValue" checked="@(Model.Template == ReferenceTemplate.CiteIucn)"> @GroupText.CitationTemplateIucn</label>
    <label><input type="radio" name="lcite" value="@IucnReference.CiteQValue" checked="@(Model.Template == ReferenceTemplate.CiteQ)"> @GroupText.CitationTemplateQ</label>
</fieldset>
