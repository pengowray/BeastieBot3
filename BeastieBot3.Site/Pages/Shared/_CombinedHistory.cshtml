@model TaxonPageModel
@* The combined assessment history: the global assessments of this taxon and of the taxa linked to
   it (CombinedHistory), in place of the taxon's own history table. A legend line for each id, with
   the swatch of its row colour, then the table, newest first. *@
@{
    var combined = Model.Combined!;
    var tool = Model as AssessmentToolModel;
    var selected = tool?.Selected;
    var thisPage = combined.ThisPage;
    string NameHtml(TaxonRow t) => ScientificNameMarkup.ToHtml(t.ScientificName, t.SubpopulationName);
}
<section class="history combined-history" aria-labelledby="history-heading">
    <h2 id="history-heading">@SiteText.HeadingCombinedHistory</h2>
    <p>@SiteText.CombinedIntro(combined.Ids.Select(i => i.TaxonId).ToList())</p>
    <ul class="id-legend">
        @foreach (var id in combined.Ids) {
            <li>
                @if (id.TintClass is { } tint) {
                    <span class="id-swatch @tint" aria-hidden="true"></span>
                }
                <span>
                    @if (id.IsThisPage) {
                        <strong>@SiteText.IucnIdLink(id.TaxonId)</strong> <span class="tag">@SiteText.ThisPageTag</span>
                    } else {
                        <a href="/species/@id.TaxonId">@SiteText.IucnIdLink(id.TaxonId)</a>
                    }@SiteText.LegendBeforeName<span class="sci-name">@Html.Raw(NameHtml(id.Taxon))</span>@SiteText.LegendAfterName(id.Taxon.InRelease, Model.Version, id.Global.Count, id.FirstYear, id.LastYear)
                    @switch (id.Link) {
                        case HistoryLink.SameName:
                            @SiteText.LegendSameName(thisPage.TaxonId)
                            break;
                        case HistoryLink.NameIsSynonymOfThisTaxon:
                            @SiteText.SynonymOfBefore<span class="sci-name">@Html.Raw(NameHtml(id.Taxon))</span>@SiteText.SynonymOfMiddle<span class="sci-name">@Html.Raw(NameHtml(thisPage.Taxon))</span><text>.</text>
                            break;
                        case HistoryLink.ThisNameIsSynonymOfIt:
                            @SiteText.SynonymOfBefore<span class="sci-name">@Html.Raw(NameHtml(thisPage.Taxon))</span>@SiteText.SynonymOfMiddle<span class="sci-name">@Html.Raw(NameHtml(id.Taxon))</span><text>.</text>
                            break;
                    }
                </span>
            </li>
        }
    </ul>
    @if (combined.Rows.Count > 0) {
        var historyNotes = Model.TableNotes(combined.Rows.Select(r => (r.Assessment, r.Id.IsThisPage)));
        var anyDoiTitleName = false;
        <div class="table-scroll">
            <table class="combined-table">
                <thead>
                    <tr>
                        <th scope="col">@SiteText.ColPublished</th>
                        <th scope="col">@SiteText.ColIucnId</th>
                        @if (combined.ShowNames) {
                            <th scope="col">@SiteText.ColName</th>
                        }
                        <th scope="col">@SiteText.ColCategory</th>
                        @if (historyNotes.ShowReasonColumn) {
                            <th scope="col">@SiteText.ColReasonForChange</th>
                        }
                        <th scope="col">@SiteText.ColCriteria</th>
                        <th scope="col" class="narrow-hide">@SiteText.ColAssessed</th>
                        @if (tool is not null) {
                            <th scope="col">@tool.ToolColumnHeading</th>
                        }
                        <th scope="col">@SiteText.ColAssessment</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in combined.Rows) {
                        var a = row.Assessment;
                        var own = row.Id.IsThisPage;
                        var isShown = own && selected?.AssessmentId == a.AssessmentId;
                        var isLatest = a.AssessmentId == Model.LatestGlobal?.AssessmentId
                            || (!own && row.Id.Taxon.InRelease && a.AssessmentId == row.Id.Taxon.LatestGlobalAssessmentId);
                        var versionNote = Model.VersionNote(a);
                        var doiTitleName = Model.DoiTitleName(a, row.Id.Taxon);
                        anyDoiTitleName |= doiTitleName is not null;
                        var rowClass = string.Join(' ', new[] { row.Id.TintClass, isShown ? "shown" : null }.Where(c => c is not null));
                        <tr class="@(rowClass.Length == 0 ? null : rowClass)">
                            <th scope="row">@a.YearPublished @if (isLatest) {<span class="tag">@SiteText.Latest</span>}@if (versionNote is not null) {<text> </text><span class="version-note">@versionNote</span>}@if (doiTitleName is not null) {<partial name="_DoiTitleName" model="doiTitleName" />}</th>
                            <td class="iucn-id">
                                @if (own) {
                                    @a.TaxonId<span class="tag">@SiteText.ThisPageTag</span>
                                } else {
                                    <a href="/species/@a.TaxonId" aria-label="@SiteText.IucnIdLink(a.TaxonId)">@a.TaxonId</a>
                                }
                            </td>
                            @if (combined.ShowNames) {
                                <td><span class="sci-name">@Html.Raw(ScientificNameMarkup.ToHtml(row.Id.Taxon.ScientificName, row.Id.Taxon.SubpopulationName))</span></td>
                            }
                            <td><partial name="_Badge" model="@historyNotes.BadgeFor(a)" /></td>
                            @if (historyNotes.ShowReasonColumn) {
                                <td><partial name="_ReasonCell" model="@(new ReasonCellModel(historyNotes.CellFor(a.AssessmentId)))" /></td>
                            }
                            <td>@a.Criteria</td>
                            <td class="narrow-hide">@SiteFormat.Date(a.AssessmentDate)</td>
                            @if (tool is not null) {
                                <td>
                                    @if (isShown) {
                                        <span class="shown-label">@SiteText.Shown</span>
                                    } else if (own) {
                                        var ownIsLatest = a.AssessmentId == Model.LatestGlobal?.AssessmentId;
                                        <a data-options-link="@AssessmentToolModel.OptionsLinkKey(ownIsLatest ? null : a.AssessmentId)" href="@(tool.OptionsUrl(ownIsLatest ? null : a.AssessmentId))#wikitext" aria-label="@tool.ShowLinkAccessible(null, a.YearPublished, versionNote)">@tool.ShowLinkText</a>
                                    } else {
                                        <a data-options-link="@AssessmentToolModel.OtherIdOptionsLinkKey(row)" href="@(tool.OtherIdOptionsUrl(row))#wikitext" aria-label="@tool.ShowOtherIdAccessible(a.TaxonId, a.YearPublished, versionNote)">@tool.ShowOtherIdText(a.TaxonId)</a>
                                    }
                                </td>
                            }
                            <td><partial name="_IucnAssessmentLink" model="a" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_HistoryTableNotes" model="historyNotes" />
        <partial name="_DoiTitleNameNote" model="anyDoiTitleName" />
    }
    @if (combined.WithNotes.Count > 0) {
        @* <text> keeps the whitespace of the code lines out of the sentence ("2790 , the"). *@
        <p class="note taxonomic-notes">@SiteText.TaxonomicNotesBefore@for (var i = 0; i < combined.WithNotes.Count; i++) {
                var id = combined.WithNotes[i];
                var newest = id.NewestGlobal!;
                <text>@SiteText.ListSeparator(i, combined.WithNotes.Count)<a href="@SiteFormat.IucnAssessmentUrl(newest.TaxonId, newest.AssessmentId)">@SiteText.TaxonomicNotesLink(newest.YearPublished, id.TaxonId)</a></text>
            }@SiteText.TaxonomicNotesAfter</p>
    }
    @foreach (var id in combined.Others.Where(i => i.RegionalCount > 0)) {
        <p class="note">@SiteText.OtherRegionalBefore<a href="/species/@id.TaxonId#regional">@SiteText.IucnIdLink(id.TaxonId)</a>@SiteText.OtherRegionalAfter</p>
    }
</section>
