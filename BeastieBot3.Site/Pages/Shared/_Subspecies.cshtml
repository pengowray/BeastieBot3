@model SubspeciesList
@* The species' subspecies and varieties from the IUCN Red List, Wikidata, the Catalogue of Life, the
   Mammal Diversity Database and the Reptile Database, one
   row per name (SubspeciesRows.Build). Each source links to its record; a source with two records of
   the name links each by its id. A record that spells the name another way gives its spelling
   ("(as Panthera leo melanochaitus)"). Rows after the first SpeciesModel.ShortListLength are "more-item",
   hidden until the box below the table is ticked. *@
@{
    var subspecies = Model.HasSubspecies;
    var varieties = Model.HasVarieties;
    var hidden = Math.Max(0, Model.Rows.Count - SpeciesModel.ShortListLength);
}
<section class="subspecies-list" id="subspecies-list" aria-labelledby="subspecies-list-heading">
    <h2 id="subspecies-list-heading">@SiteText.HeadingSubspeciesList(subspecies, varieties)</h2>
    <p>@SiteText.SubspeciesListIntro(subspecies, varieties)@if (Model.HasWikidataOnlyRows) {<text> @SiteText.SubspeciesListWikidataOnly</text>}</p>
    <div class="more-list">
        <div class="table-scroll">
            <table class="names-table subspecies-table">
                <thead>
                    <tr>
                        <th scope="col">@SiteText.ColName</th>
                        <th scope="col">@SiteText.ColSource</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.Rows.Count; i++) {
                        var row = Model.Rows[i];
                        <tr class="@(i >= SpeciesModel.ShortListLength ? "more-item" : null)">
                            <th scope="row">@Html.Raw(ScientificNameMarkup.ToSynonymHtml(row.Name))@if (row.Authority is not null) {<text> </text><span class="authority">@row.Authority</span>}</th>
                            <td>@for (var j = 0; j < row.Sources.Count; j++) {
                                    var source = row.Sources[j];
                                    if (j > 0) {<text>, </text>}
                                    @* One line per branch: a line break here would put a space before the commas. *@
                                    if (source.Records.Count == 1) {<a href="@source.Records[0].Url">@source.Label</a>if (source.Records[0].OtherName is { } otherName) {@SiteText.SourceNameBefore<span class="sci-name">@Html.Raw(ScientificNameMarkup.ToSynonymHtml(otherName))</span>@SiteText.SourceNameAfter}}
                                    else {@source.Label<text> (</text>for (var k = 0; k < source.Records.Count; k++) {if (k > 0) {<text>, </text>}<a href="@source.Records[k].Url">@source.Records[k].Id</a>if (source.Records[k].OtherName is { } otherName) {@SiteText.RecordNameBefore<span class="sci-name">@Html.Raw(ScientificNameMarkup.ToSynonymHtml(otherName))</span>}}<text>)</text>}
                                    if (source.OtherAuthority is not null) {@SiteText.SourceAuthorityBefore<span class="authority">@source.OtherAuthority</span>@SiteText.SourceAuthorityAfter}
                                }</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (hidden > 0) {
            <p class="more-toggle"><label><input type="checkbox" class="show-more" autocomplete="off"> @SiteText.ShowMoreSubspecies(hidden, subspecies, varieties)</label></p>
        }
    </div>
</section>
