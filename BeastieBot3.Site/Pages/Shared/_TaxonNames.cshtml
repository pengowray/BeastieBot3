@model TaxonNames
@* The names section of a taxon page: English common names, names in other languages (each with its
   transliteration into Latin letters when it is in another script) and synonyms, each with its
   sources, then the possible synonyms found by comparing a provisional name with the name built
   from its quoted epithet. The lists after the first SpeciesModel.ShortListLength items are hidden until their box is ticked. *@
<section class="names" aria-labelledby="names-heading">
    <h2 id="names-heading">@SiteText.HeadingNames</h2>
    <h3>@SiteText.NamesEnglish</h3>
    @if (Model.English.Count == 0) {
        <p>@SiteText.NoEnglishName</p>
    } else {
        <div class="table-scroll">
            <table class="names-table">
                <thead>
                    <tr>
                        <th scope="col">@SiteText.ColName</th>
                        <th scope="col">@SiteText.ColSource</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var n in Model.English) {
                        <tr>
                            <th scope="row">@n.Name @if (n.IsIucnMain) {<span class="tag">@SiteText.IucnMainName</span>}</th>
                            <td>@string.Join(", ", n.Sources)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (Model.OtherLanguages.Count > 0) {
        <h3>@SiteText.NamesOtherLanguages</h3>
        var hiddenLanguages = Math.Max(0, Model.OtherLanguages.Count - SpeciesModel.ShortListLength);
        @* One table, one tbody per language with the language in a header cell across its rows; the
           languages after the first few are hidden until the box is ticked. *@
        <div class="more-list">
            <div class="table-scroll">
                <table class="names-table language-names">
                    <thead>
                        <tr>
                            <th scope="col">@SiteText.ColLanguage</th>
                            <th scope="col">@SiteText.ColName</th>
                            <th scope="col">@SiteText.ColSource</th>
                        </tr>
                    </thead>
                    @for (var i = 0; i < Model.OtherLanguages.Count; i++) {
                        var g = Model.OtherLanguages[i];
                        <tbody class="@(i >= SpeciesModel.ShortListLength ? "more-item" : null)">
                            @for (var j = 0; j < g.Names.Count; j++) {
                                var n = g.Names[j];
                                <tr>
                                    @if (j == 0) {
                                        <th scope="rowgroup" rowspan="@g.Names.Count">@g.Language</th>
                                    }
                                    <td lang="@g.Lang">@n.Name@if (n.Latin is { } latin) {<text> </text><span class="transliteration" lang="@(g.Lang is null ? "und-Latn" : g.Lang + "-Latn")" title="@SiteText.TransliterationTitle">@latin</span>}</td>
                                    <td>@string.Join(", ", n.Sources)</td>
                                </tr>
                            }
                        </tbody>
                    }
                </table>
            </div>
            @if (hiddenLanguages > 0) {
                <p class="more-toggle"><label><input type="checkbox" class="show-more" autocomplete="off"> @SiteText.ShowMoreLanguages(hiddenLanguages)</label></p>
            }
        </div>
    }

    @if (Model.Synonyms.Count > 0) {
        <h3>@SiteText.NamesSynonyms</h3>
        @* One table; the synonyms after the first few are hidden until the box is ticked. *@
        <div class="more-list">
            <partial name="_SynonymTable" model="Model.Synonyms" />
            @if (Model.Synonyms.Count > SpeciesModel.ShortListLength) {
                <p class="more-toggle"><label><input type="checkbox" class="show-more" autocomplete="off"> @SiteText.ShowMoreSynonyms(Model.Synonyms.Count - SpeciesModel.ShortListLength)</label></p>
            }
        </div>
    }

    @if (Model.PossibleSynonyms.Count > 0) {
        <h3 id="possible-synonyms">@SiteText.NamesPossibleSynonyms</h3>
        <p class="names-intro">@SiteText.PossibleSynonymsIntro</p>
        <div class="table-scroll">
            <table class="names-table possible-synonyms-table">
                <thead>
                    <tr>
                        <th scope="col">@SiteText.ColName</th>
                        <th scope="col">@SiteText.ColPossibleSynonymFoundIn</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.PossibleSynonyms) {
                        <tr>
                            <th scope="row">
                                <a href="@p.Url" class="sci-name">@Html.Raw(ScientificNameMarkup.ToHtml(p.Name))</a>
                                <div class="match-note">@(p.IsProvisional ? SiteText.PossibleSynonymProvisionalName : SiteText.PossibleSynonymFormalName)</div>
                            </th>
                            <td>@(p.TaxonId is { } id ? SiteText.PossibleSynonymIucnSource(id) : SiteText.ExtraSourcesName(p.InCol, p.InWikidata))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
