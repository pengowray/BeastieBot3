@model BeastieBot3.Site.Web.ToolPaths.Tab
@using BeastieBot3.Site.Web
@* The row of tabs above every tool page, as a search engine shows its kinds of search: the tab of the
   page's tool is marked as the current one. *@
<nav class="tool-tabs" aria-label="@SiteText.ToolTabsLabel">
    <ul>
        @foreach (var (tab, href, text) in new[] {
                     (ToolPaths.Tab.Cite, ToolPaths.Cite, SiteText.ToolCite),
                     (ToolPaths.Tab.Update, ToolPaths.UpdateStatuses, SiteText.ToolUpdateLink),
                     (ToolPaths.Tab.List, ToolPaths.ListMaker, SiteText.ToolListMaker),
                 }) {
            <li><a href="@href" aria-current="@(tab == Model ? "page" : null)">@text</a></li>
        }
    </ul>
</nav>
