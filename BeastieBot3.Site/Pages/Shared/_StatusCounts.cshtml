@model BeastieBot3.Site.Pages.StatusCountsModel
@using BeastieBot3.Site.Update
@* How many statuses of each category the updated wikitext has, as the {{IUCN statuses}} box counts
   them (IucnStatusesSummary.Count). Categories with none are left out of the row. *@
@{ var counts = Model.Counts; }
<div class="update-counts">
    <p class="update-counts-row">
        <span class="update-counts-label">@UpdateText.CountsLabel</span>
        @foreach (var key in IucnStatusesSummary.Keys.Where(k => counts.ByKey[k] > 0)) {
            <span class="update-count"><partial name="_Badge" model="@BadgeModel.ForStatusCode(key.ToUpperInvariant(), showLabel: false)" /> @SiteFormat.Number(counts.ByKey[key])@if (key == "cr" && UpdateText.CountsPossiblyExtinct(counts.PossiblyExtinct, counts.PossiblyExtinctInTheWild) is { } pe) {<text> @pe</text>}</span>
        }
        <span class="update-count update-count-total">@UpdateText.CountsTotal(counts.Items)</span>
    </p>
    <p class="help">@UpdateText.CountsHelp(counts)</p>
    @if (Model.ShowBox) {
        <p class="help">@UpdateText.CountsBoxLabel <code>@counts.Box</code></p>
    }
</div>
