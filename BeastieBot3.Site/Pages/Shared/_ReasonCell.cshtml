@model ReasonCellModel
@* A "Reason for change" cell: IUCN Table 7's reason code with a footnote naming the table, or, in
   light italic, why there is none. *@
@if (Model.Cell is { } cell) {
    switch (cell.Kind) {
        case ReasonCellKind.Reason:
            @SiteText.ReasonLabel(cell.Code!)
            break;
        case ReasonCellKind.BeforeTables:
            <span class="no-value">@SiteText.ReasonBeforeTables</span>
            break;
        case ReasonCellKind.FirstAssessment:
            <span class="no-value">@SiteText.ReasonFirstAssessment</span>
            break;
        case ReasonCellKind.NoChange:
            <span class="no-value reason-no-change">@SiteText.ReasonNoChange</span>
            break;
        case ReasonCellKind.NoneGiven:
            <span class="no-value">@SiteText.ReasonNoneGiven</span>
            break;
        default:
            <span class="no-value">@SiteText.ReasonNotFound</span>
            break;
    }
    if (cell.Footnote is { } number) {<partial name="_FootnoteRef" model="@FootnoteRef.History(number)" />}
}
