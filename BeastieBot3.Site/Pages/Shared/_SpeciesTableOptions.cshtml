@model GroupListModel
@using BeastieBot3.Site.Lists
@* The options of the species tables ({{Species table}}), shown when the list type is tables. *@
@{
    var table = Model.Table;
}
@* Each fieldset with an info button is named by its legend's text alone (aria-labelledby). *@
<fieldset class="option-group" data-list-type="tables" hidden="@(!table.IsTable)" aria-labelledby="legend-tables">
    <legend><span id="legend-tables">@GroupText.OptionTables</span> <partial name="_InfoTip" model="@(new InfoTipModel("tip-tables", GroupText.InfoTipLabel(GroupText.OptionTables), GroupText.SpeciesCountHelp))" /></legend>
    <fieldset class="option-group" aria-labelledby="legend-references">
        <legend><span id="legend-references">@GroupText.OptionReferences</span> <partial name="_InfoTip" model="@(new InfoTipModel("tip-references", GroupText.InfoTipLabel(GroupText.OptionReferences), GroupText.ReferencesHelp))" /></legend>
        @foreach (var (value, label) in new[] {
                     (TableReferences.None, GroupText.ReferencesNone),
                     (TableReferences.ListDefined, GroupText.ReferencesListDefined),
                     (TableReferences.Inline, GroupText.ReferencesInline),
                 }) {
            <label><input type="radio" name="refs" value="@SpeciesTableQuery.ReferencesKey(value)" checked="@(table.References == value)"> @label</label>
        }
    </fieldset>
    <fieldset class="option-group" aria-labelledby="legend-ref-names">
        <legend><span id="legend-ref-names">@GroupText.OptionRefNames</span> <partial name="_InfoTip" model="@(new InfoTipModel("tip-ref-names", GroupText.InfoTipLabel(GroupText.OptionRefNames), GroupText.RefNamesHelp))" /></legend>
        @foreach (var (value, label) in new[] {
                     (TableRefNames.CommonName, GroupText.RefNamesCommon),
                     (TableRefNames.TaxonId, GroupText.RefNamesId),
                     (TableRefNames.ScientificName, GroupText.RefNamesSci),
                 }) {
            <label><input type="radio" name="refnames" value="@SpeciesTableQuery.RefNamesKey(value)" checked="@(table.RefNames == value)"> @label</label>
        }
    </fieldset>
    <fieldset class="option-group">
        <legend>@GroupText.OptionCitationTemplate</legend>
        <label><input type="radio" name="@IucnReference.QueryKey" value="@IucnReference.CiteIucnValue" checked="@(table.Template == ReferenceTemplate.CiteIucn)"> @GroupText.CitationTemplateIucn</label>
        <label><input type="radio" name="@IucnReference.QueryKey" value="@IucnReference.CiteQValue" checked="@(table.Template == ReferenceTemplate.CiteQ)"> @GroupText.CitationTemplateQ</label>
    </fieldset>
    <fieldset class="option-group">
        <legend>@GroupText.OptionColumns</legend>
        @foreach (var (value, label) in new[] {
                     (TableColumns.All, GroupText.ColumnsAll),
                     (TableColumns.NoDiet, GroupText.ColumnsNoDiet),
                     (TableColumns.NoEcology, GroupText.ColumnsNoEcology),
                 }) {
            <label><input type="radio" name="cols" value="@SpeciesTableQuery.ColumnsKey(value)" checked="@(table.Columns == value)"> @label</label>
        }
    </fieldset>
    <label><input type="hidden" name="summary" value="0"><input type="checkbox" name="summary" value="1" checked="@table.Summary"> @GroupText.OptionSummary</label>
</fieldset>
