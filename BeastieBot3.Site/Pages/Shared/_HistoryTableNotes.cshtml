@model HistoryTableNotes
@* Under a history table: where its "Reason for change" entries come from, with links to the Table 7
   PDFs, what a blank cell means, and the footnotes of its [PE] and [PEW] markers. *@
@if (Model.ShowReasonColumn) {
    var tables = Model.ReasonTables;
    <p class="note reason-note">@SiteText.ReasonNoteBefore@SiteText.ReasonNoteVersions(tables.Count)@for (var i = 0; i < tables.Count; i++) {
            var (release, url) = tables[i];
            <text>@SiteText.VersionSeparator(i, tables.Count)<a href="@url" aria-label="@SiteText.ReasonNoteLinkLabel(release)">@release</a></text>
        }@SiteText.ReasonNoteAfter @SiteText.ReasonNoteBlank@if (Model.HasBlank2008Row) {<text> @SiteText.ReasonNote2008</text>}</p>
}
@foreach (var note in Model.Footnotes) {
    <p class="note listed-tag-note" id="@HistoryTableNotes.FootnoteId(note.AssessmentId)">@note.Text</p>
}
