@model HistoryTableNotes
@* Under a history table: its numbered footnotes (the Table 7 each reason is from, with its PDF, and
   the Possibly Extinct listings that are only in IUCN's tables), then what the dash means. *@
@if (Model.Footnotes.Count > 0) {
    <ol class="footnotes">
        @foreach (var note in Model.Footnotes) {
            <li id="@HistoryTableNotes.FootnoteId(note.Number)" value="@note.Number">@if (note.TableRelease is { } release) {<text>@SiteText.TableFootnoteBefore<a href="@note.TableUrl">@SiteText.TableFootnoteLink(release)</a>@SiteText.TableFootnoteAfter@if (note.Genuine2008) {@SiteText.TableFootnote2008}</text>} else {@note.Text}</li>
        }
    </ol>
}
@if (Model.HasBeforeTables) {
    <p class="note footnote-legend">@SiteText.ReasonBeforeTablesLegend</p>
}
