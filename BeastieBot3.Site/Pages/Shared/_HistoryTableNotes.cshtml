@model HistoryTableNotes
@* Under an assessment table: its numbered footnotes (the Table 7 each reason or name is from, with
   its PDF, the Possibly Extinct listings that are only in IUCN's tables, and where a name from a DOI
   title comes from), then what the dash means. *@
@if (Model.Footnotes.Count > 0) {
    <ol class="footnotes">
        @foreach (var note in Model.Footnotes) {
            <li id="@note.Id" value="@note.Number">@if (note.TableRelease is { } release) {<text>@SiteText.TableFootnoteBefore<a href="@note.TableUrl">@SiteText.TableFootnoteLink(release)</a>@SiteText.TableFootnoteAfter@if (note.Genuine2008) {@SiteText.TableFootnote2008}</text>} else {@note.Text}</li>
        }
    </ol>
}
@if (Model.HasBeforeTables) {
    <p class="note footnote-legend">@SiteText.ReasonBeforeTablesLegend</p>
}
