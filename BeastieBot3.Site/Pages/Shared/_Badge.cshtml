@model BadgeModel
@* The footnote reference goes inside the label (a flex item of .category), so it stays on the label's last line. *@
<span class="category@(Model.Large ? " category-large" : "")"><span class="badge @Model.Category.CssClass">@Model.Category.BadgeText</span>@if (Model.ShowLabel) {<text> </text><span class="category-label">@Model.Category.Label@if (Model.Footnote is { } footnote) {<partial name="_FootnoteRef" model="@FootnoteRef.History(footnote)" />}</span>} else if (Model.Footnote is { } footnote) {<span><partial name="_FootnoteRef" model="@FootnoteRef.History(footnote)" /></span>}</span>