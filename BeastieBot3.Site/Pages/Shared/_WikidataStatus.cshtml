@model WikidataStatusPartial
@* The taxon item's IUCN conservation status (P141) beside the latest global assessment, and the
   QuickStatements commands that bring it up to date (WikidataCite.BuildStatus). *@
@{
    var view = Model.View;
    var plan = view.Plan;
    var latest = Model.Latest;
    var iucnLabel = IucnCategories.Describe(latest).Label;
    var targetQid = plan?.TargetQid ?? WikidataStatusEdit.TargetQid(latest.Category);
    var showTable = view.IsReview || (view.Scope == WikidataStatusScope.Offered && plan is not null);
}
<section class="wikidata-status" id="wikidata-status" aria-labelledby="wikidata-status-heading">
    <h2 id="wikidata-status-heading">@SiteText.HeadingWikidataStatus</h2>
    @switch (view.Scope) {
        case WikidataStatusScope.NotSpeciesOrSubspecies:
            <p>@SiteText.StatusNotSpecies</p>
            break;
        case WikidataStatusScope.NoItem:
            <p>@SiteText.StatusNoItem(view.TaxonId)</p>
            break;
        case WikidataStatusScope.MatchedByName:
            <p>@SiteText.StatusMatchedByNameBefore<a href="@view.TaxonItemUrl">@view.TaxonItemQid</a>@SiteText.StatusMatchedByNameAfter(view.TaxonId)</p>
            break;
        case WikidataStatusScope.StatementsUnknown:
            <p>@SiteText.StatusNotDownloadedBefore<a href="@view.TaxonItemUrl">@view.TaxonItemQid</a>.</p>
            break;
    }
    @if (showTable) {
        var current = view.Statements.Where(s => !s.IsDeprecated).OrderBy(s => s.IsPreferred ? 0 : 1).ToList();
        var showRanks = current.Count > 1;
        var hasOthers = current.Any(s => !s.CitesIucn);
        <div class="table-scroll">
            <table class="status-compare">
                <thead>
                    <tr>
                        <th scope="col">@SiteText.StatusColSource</th>
                        <th scope="col">@SiteText.StatusColValue</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <th scope="row">@SiteText.StatusRowIucn(Model.Release)</th>
                        <td>@(targetQid is null ? SiteText.StatusNoValueFor(latest.Category) : SiteText.StatusValue(targetQid))</td>
                    </tr>
                    <tr>
                        <th scope="row">@SiteText.StatusRowWikidataBefore<a href="@view.TaxonItemUrl">@view.TaxonItemQid</a>@SiteText.StatusRowWikidataAfter(view.DownloadedText)@(view.Scope == WikidataStatusScope.TaxonIdDeprecated ? SiteText.StatusRowTaxonIdDeprecated : null)</th>
                        <td>
                            @if (view.IsReview && view.Statements.Count == 0 && view.DownloadedText is null) {
                                @SiteText.StatusNotDownloaded
                            } else if (current.Count == 0) {
                                @SiteText.StatusNone
                            } else {
                                <ul class="plain-list">
                                    @foreach (var statement in current) {
                                        <li>@SiteText.StatusStatement(statement, showRanks)</li>
                                    }
                                </ul>
                            }
                        </td>
                    </tr>
                    @foreach (var other in view.OtherItems) {
                        var otherCurrent = other.Statements?.Where(s => !s.IsDeprecated).OrderBy(s => s.IsPreferred ? 0 : 1).ToList();
                        <tr>
                            <th scope="row">@SiteText.StatusRowWikidataBefore<a href="@SiteFormat.WikidataUrl(other.Qid)">@other.Qid</a>@(other.TaxonIdDeprecated ? SiteText.StatusRowTaxonIdDeprecated : null)</th>
                            <td>
                                @if (otherCurrent is null) {
                                    @SiteText.StatusNotDownloaded
                                } else if (otherCurrent.Count == 0) {
                                    @SiteText.StatusNone
                                } else {
                                    <ul class="plain-list">
                                        @foreach (var statement in otherCurrent) {
                                            <li>@SiteText.StatusStatement(statement, otherCurrent.Count > 1)</li>
                                        }
                                    </ul>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (targetQid is { } mappedTarget) {
            var value = SiteText.StatusValue(mappedTarget);
            @if (latest.Category == "CR" && latest.PossiblyExtinct) {
                <p class="help">@SiteText.StatusMappedPossiblyExtinct(iucnLabel, value)</p>
            } else if (latest.Category == "CR" && latest.PossiblyExtinctInTheWild) {
                <p class="help">@SiteText.StatusMappedPossiblyExtinctInTheWild(iucnLabel, value)</p>
            } else if (latest.Category.StartsWith("LR/", StringComparison.Ordinal)) {
                <p class="help">@SiteText.StatusMappedLowerRisk(iucnLabel, value)</p>
            }
        }
        @if (hasOthers && !view.IsReview) {
            <p class="help">@SiteText.StatusOthersNote</p>
        }

        @switch (view.Scope) {
            case WikidataStatusScope.TaxonIdOnSeveralItems:
                <p class="status-verdict">@SiteText.StatusSeveralItems(view.OtherItems.Count + 1, view.TaxonId)</p>
                break;
            case WikidataStatusScope.TaxonIdDeprecated:
                <p class="status-verdict">@SiteText.StatusTaxonIdDeprecatedBefore<a href="@view.TaxonItemUrl">@view.TaxonItemQid</a>@SiteText.StatusTaxonIdDeprecatedAfter(view.TaxonId)</p>
                break;
        }
    }
    @if (view.Scope == WikidataStatusScope.Offered && plan is not null) {
        @switch (plan.Outcome) {
            case StatusEditOutcome.Agrees:
                @if (!plan.AlreadyCited) {
                    <p class="status-verdict">@SiteText.StatusAgrees</p>
                } else if (view.AssessmentItemQid is { } citedItem && plan.Current.Any(s => s.Value == plan.TargetQid && (s.StatedIn ?? []).Contains(citedItem))) {
                    <p class="status-verdict">@SiteText.StatusAgreesCited</p>
                } else {
                    <p class="status-verdict">@SiteText.StatusAgreesCitedTaxonId(view.TaxonId)</p>
                }
                break;
            case StatusEditOutcome.Differs:
                <p class="status-verdict">@SiteText.StatusDiffers</p>
                break;
            case StatusEditOutcome.Missing:
                <p class="status-verdict">@(plan.Current.Count == 0 ? SiteText.StatusMissing : SiteText.StatusMissingNoIucnReference)</p>
                break;
            case StatusEditOutcome.NoValue:
                <p class="status-verdict">@SiteText.StatusNoValue(iucnLabel, latest.Category)</p>
                break;
            case StatusEditOutcome.Blocked:
                var blockedValue = SiteText.StatusValue(plan.TargetQid);
                <p class="status-verdict">
                    @(plan.Block == StatusEditBlock.DeprecatedStatementHasTheValue
                        ? SiteText.StatusBlockedDeprecated(blockedValue)
                        : SiteText.StatusBlockedSeveral(view.Statements.Count(s => s.Value == plan.TargetQid), blockedValue))
                </p>
                break;
        }

        <partial name="_WikidataStatusPlan" model="@(new WikidataStatusPlanPartial(plan, view.Commands, view.QuickStatementsUrl, IsAlternative: false, Model.Release))" />

        @if (view.AltPlan is { } alt) {
            <details class="status-keep" id="wikidata-status-alt">
                <summary>@SiteText.StatusAltSummary(alt.Choice)</summary>
                <partial name="_WikidataStatusPlan" model="@(new WikidataStatusPlanPartial(alt, view.AltCommands, view.AltQuickStatementsUrl, IsAlternative: true, Model.Release))" />
            </details>
        }
    }
</section>
