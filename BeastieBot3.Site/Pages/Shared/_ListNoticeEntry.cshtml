@using BeastieBot3.Site.Lists
@model ListNoticeSideModel
@* One name in the possible-duplicates panel, linked to its page on this site (/species/{id} for
   IUCN, /col/{id} or /wikidata/{qid} for a species from the Catalogue of Life or Wikidata); then its
   source and, when the column heading does not say it, whether it is in this list. *@
@{
    var entry = Model.Side.Entry;
    var href = entry.Source switch {
        ListSource.Iucn when entry.TaxonId is { } id => "/species/" + id.ToString(System.Globalization.CultureInfo.InvariantCulture),
        ListSource.Col when entry.ColId is { } colId => "/col/" + Uri.EscapeDataString(colId),
        ListSource.Wikidata when entry.WikidataQid is { } qid => "/wikidata/" + Uri.EscapeDataString(qid),
        _ => null,
    };
}
@if (href is null) {<i>@entry.ScientificName</i>} else {<a href="@href" class="sci-name">@entry.ScientificName</a>} <span class="notice-tags"><span class="notice-source">@GroupSourceText.ShortName(entry.Source)</span>@if (Model.ShowState) {<text> · </text><span class="notice-state notice-state-@Model.Side.State.ToString().ToLowerInvariant()">@GroupSourceText.State(Model.Side.State, Model.GroupRank)</span>}</span>
