@model TaxonPageModel
@* The taxon's assessment tables: the global assessment history (or the combined history of the
   linked IUCN ids) and the latest assessment in each region, with the assessments IUCN published
   under a "_new" record of the taxon after the taxon's own. On the wikitext page they have a column
   that picks the assessment (AssessmentToolModel: "Show wikitext" on the Wikipedia page). On the
   taxon page, the taxobox status comparison comes between the two tables. *@
@{
    var tool = Model as AssessmentToolModel;
}
@if (Model.Combined is not null) {
    <partial name="_CombinedHistory" model="Model" />
} else if (Model.GlobalHistory.Count > 0) {
    var historyNotes = Model.TableNotes(Model.GlobalHistory.Select(a => (a, true)));
    <section class="history" aria-labelledby="history-heading">
        <h2 id="history-heading">@SiteText.HeadingHistory</h2>
        <div class="table-scroll">
            <table>
                <thead>
                    <tr>
                        <th scope="col">@SiteText.ColPublished</th>
                        <th scope="col">@SiteText.ColCategory</th>
                        @if (historyNotes.ShowReasonColumn) {
                            <th scope="col">@SiteText.ColReasonForChange</th>
                        }
                        <th scope="col">@SiteText.ColCriteria</th>
                        <th scope="col" class="narrow-hide">@SiteText.ColAssessed</th>
                        @if (tool is not null) {
                            <th scope="col">@tool.ToolColumnHeading</th>
                        }
                        <th scope="col">@SiteText.ColAssessment</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.GlobalHistory) {
                        var isShown = tool?.Selected?.AssessmentId == a.AssessmentId;
                        var isLatest = a.AssessmentId == Model.LatestGlobal?.AssessmentId;
                        var versionNote = Model.VersionNote(a);
                        var publishedName = historyNotes.NameFor(a.AssessmentId);
                        <tr class="@(isShown ? "shown" : null)">
                            <th scope="row">@a.YearPublished @if (isLatest) {<span class="tag">@SiteText.Latest</span>}@if (versionNote is not null) {<text> </text><span class="version-note">@versionNote</span>}@if (publishedName is not null) {<text> </text><partial name="_PublishedName" model="publishedName" />}</th>
                            <td><partial name="_Badge" model="@historyNotes.BadgeFor(a)" /></td>
                            @if (historyNotes.ShowReasonColumn) {
                                <td><partial name="_ReasonCell" model="@(new ReasonCellModel(historyNotes.CellFor(a.AssessmentId)))" /></td>
                            }
                            <td>@a.Criteria</td>
                            <td class="narrow-hide">@SiteFormat.Date(a.AssessmentDate)</td>
                            @if (tool is not null) {
                                <td>
                                    @if (isShown) {
                                        <span class="shown-label">@SiteText.Shown</span>
                                    } else {
                                        <a data-options-link="@AssessmentToolModel.OptionsLinkKey(isLatest ? null : a.AssessmentId)" href="@(tool.OptionsUrl(isLatest ? null : a.AssessmentId))#wikitext" aria-label="@tool.ShowLinkAccessible(null, a.YearPublished, versionNote)">@tool.ShowLinkText</a>
                                    }
                                </td>
                            }
                            <td><partial name="_IucnAssessmentLink" model="a" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_HistoryTableNotes" model="historyNotes" />
        <partial name="_EarlierIds" model="Model" />
    </section>
} else if (Model.InRelease && Model.EarlierIds.Count > 0) {
    <section class="history" aria-labelledby="history-heading">
        <h2 id="history-heading">@SiteText.HeadingHistory</h2>
        <partial name="_EarlierIds" model="Model" />
    </section>
}

@if (tool is null && Model.TaxoboxCheck is { } taxoboxCheck) {
    <section class="taxobox-check" id="taxobox-status" aria-labelledby="taxobox-status-heading">
        <h2 id="taxobox-status-heading">@SiteText.TaxoboxStatusHeading</h2>
        <div class="taxobox-status"><partial name="_TaxoboxStatus" model="@(new TaxoboxStatusView(taxoboxCheck, Model.LatestGlobal))" /></div>
        @if (Model.TaxoboxWikitextUrl is { } taxoboxUrl) {
            <p class="taxobox-wikitext-link">@SiteText.TaxoboxWikitextBefore<a href="@taxoboxUrl">@Model.TaxoboxWikitextLabel</a>@SiteText.TaxoboxWikitextAfter</p>
        }
    </section>
}

@if (Model.RegionalRows.Count > 0 || Model.WorkingNameRows.Count > 0) {
    var allNoScope = Model.RegionalRows.All(r => r.HasNoScope) && Model.WorkingNameRows.All(r => r.Assessment.HasNoScope);
    var regionalNotes = Model.RegionalNotes(Model.RegionalRows);
    <section class="regional" id="regional" aria-labelledby="regional-heading">
        <h2 id="regional-heading">@(allNoScope ? SiteText.HeadingNoScope : SiteText.HeadingRegional)</h2>
        <div class="table-scroll">
            <table>
                <thead>
                    <tr>
                        <th scope="col">@SiteText.ColRegion</th>
                        <th scope="col">@SiteText.ColCategory</th>
                        <th scope="col">@SiteText.ColCriteria</th>
                        <th scope="col">@SiteText.ColPublished</th>
                        @if (tool is not null) {
                            <th scope="col">@tool.ToolColumnHeading</th>
                        }
                        <th scope="col">@SiteText.ColAssessment</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.RegionalRows) {
                        var isShown = tool?.Selected?.AssessmentId == a.AssessmentId;
                        var isDefault = a.AssessmentId == Model.StatusAssessment?.AssessmentId;
                        var versionNote = Model.VersionNote(a);
                        var publishedName = regionalNotes.NameFor(a.AssessmentId);
                        <tr class="@(isShown ? "shown" : null)">
                            <th scope="row"><partial name="_ScopeLabel" model="@Model.ScopeLabel(a, "regional")" />@if (publishedName is not null) {<text> </text><partial name="_PublishedName" model="publishedName" />}</th>
                            <td><partial name="_Badge" model="@BadgeModel.For(a)" /></td>
                            <td>@a.Criteria</td>
                            <td>@a.YearPublished@if (versionNote is not null) {<text> </text><span class="version-note">@versionNote</span>}</td>
                            @if (tool is not null) {
                                <td>
                                    @if (isShown) {
                                        <span class="shown-label">@SiteText.Shown</span>
                                    } else {
                                        <a data-options-link="@AssessmentToolModel.OptionsLinkKey(isDefault ? null : a.AssessmentId)" href="@(tool.OptionsUrl(isDefault ? null : a.AssessmentId))#wikitext" aria-label="@tool.ShowLinkAccessible(a.Scope, a.YearPublished, versionNote)">@tool.ShowLinkText</a>
                                    }
                                </td>
                            }
                            <td><partial name="_IucnAssessmentLink" model="a" /></td>
                        </tr>
                    }
                    @foreach (var linked in Model.WorkingNameRows) {
                        var a = linked.Assessment;
                        var other = linked.Taxon;
                        var versionNote = Model.VersionNote(a);
                        <tr class="published-under-row">
                            <th scope="row">
                                <partial name="_ScopeLabel" model="@Model.ScopeLabel(a, "regional")" />
                                <div class="published-under">@SiteText.PublishedUnderBefore<span class="sci-name">@Html.Raw(ScientificNameMarkup.ToHtml(other.ScientificName, other.SubpopulationName))</span>@SiteText.PublishedUnderMiddle<a href="/species/@other.TaxonId">@SiteText.IucnIdLink(other.TaxonId)</a>@SiteText.PublishedUnderAfter</div>
                            </th>
                            <td><partial name="_Badge" model="@BadgeModel.For(a)" /></td>
                            <td>@a.Criteria</td>
                            <td>@a.YearPublished@if (versionNote is not null) {<text> </text><span class="version-note">@versionNote</span>}</td>
                            @if (tool is not null) {
                                <td>
                                    <a data-options-link="@AssessmentToolModel.OtherIdOptionsLinkKey(other.TaxonId, a.AssessmentId)" href="@(tool.OtherTaxonOptionsUrl(other, a, []))#wikitext" aria-label="@tool.ShowOtherIdAccessible(other.TaxonId, a.YearPublished, versionNote)">@tool.ShowOtherIdText(other.TaxonId)</a>
                                </td>
                            }
                            <td><partial name="_IucnAssessmentLink" model="a" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_HistoryTableNotes" model="regionalNotes" />
    </section>
}
