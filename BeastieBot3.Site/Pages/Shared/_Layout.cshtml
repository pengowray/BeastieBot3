@inject SiteDatabase Db
@inject Microsoft.Extensions.Options.IOptions<SiteOptions> SiteOptions
@{
    var title = ViewData["Title"] as string;
    var pageTitle = string.IsNullOrEmpty(title) ? SiteText.SiteName : $"{title} | {SiteText.SiteShortName}";
    var hideHeaderSearch = ViewData["HideHeaderSearch"] is true;
    var canonical = ViewData["Canonical"] as string;
    var version = Db.Snapshot?.IucnRelease;
    var built = Db.Snapshot?.Get(BeastieBot3.Shared.SiteData.SiteDbSchema.MetaKeys.BuiltAtUtc) is { } builtAt
        && DateTimeOffset.TryParse(builtAt, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.AssumeUniversal, out var builtTime)
        ? SiteFormat.Date(DateOnly.FromDateTime(builtTime.UtcDateTime)) : null;
    // When the assessments were downloaded from the IUCN Red List API: "between 16 November 2025 and 3 October 2026".
    var apiRange = SiteFormat.TryParseDate(Db.Snapshot?.Get(BeastieBot3.Shared.SiteData.SiteDbSchema.MetaKeys.IucnApiDownloadedFrom), out var apiFrom)
        && SiteFormat.TryParseDate(Db.Snapshot?.Get(BeastieBot3.Shared.SiteData.SiteDbSchema.MetaKeys.IucnApiDownloadedTo), out var apiTo)
        ? SiteFormat.DateRange(apiFrom, apiTo) : null;
    var sourceUrl = SiteOptions.Value.SourceUrl;
    // The tool whose link in the header is marked as the current page.
    var toolTab = ViewData["ToolTab"] as BeastieBot3.Site.Web.ToolPaths.Tab? ?? BeastieBot3.Site.Web.ToolPaths.Tab.None;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title>@pageTitle</title>
    <meta name="description" content="@SiteText.Description">
    @if (!string.IsNullOrEmpty(canonical)) {
        <link rel="canonical" href="@canonical">
    }
    @if (ViewData["NoIndex"] is true) {
        <meta name="robots" content="noindex">
    }
    @* The bat is Oversample's logo, art commissioned by the site's author. *@
    <link rel="icon" href="/favicon.ico">
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png">
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    @* Not deferred: theme.js sets the theme chosen in this browser before the page is drawn. *@
    <script src="~/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/site.css" asp-append-version="true">
    <script src="~/site.js" asp-append-version="true" defer></script>
</head>
<body>
    <a class="skip-link" href="#main">@SiteText.SkipToContent</a>
    <header class="site-header">
        <div class="wrap header-row">
            <a class="site-name" href="/"><img class="site-logo" src="/logo-80.png" width="40" height="40" alt=""><span><span class="site-name-owner">@SiteText.SiteNameOwner</span>@SiteText.SiteShortName</span></a>
            @if (!hideHeaderSearch) {
                <partial name="_SearchForm" model="@(new SearchFormModel(ViewData["Query"] as string, "header"))" />
            }
            @* Hidden until theme.js runs (site.css), so a browser without JavaScript has no control
               that does nothing. The server always ticks System: the choice is made in the browser,
               so every visitor gets the same page from the output cache. The icon shown is chosen by
               site.css from data-theme on <html>; theme.js writes the current choice into the
               summary's hidden name. site.js closes the menu on Escape and on a click outside it. *@
            <details class="nav-menu theme-menu">
                <summary>
                    <svg class="theme-icon theme-icon-system" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor"/></svg>
                    <svg class="theme-icon theme-icon-light" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1L7 17M17 7l2.1-2.1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    <svg class="theme-icon theme-icon-dark" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
                    <span class="visually-hidden" id="theme-name" data-system="@SiteText.ThemeName(SiteText.ThemeSystem)" data-light="@SiteText.ThemeName(SiteText.ThemeLight)" data-dark="@SiteText.ThemeName(SiteText.ThemeDark)">@SiteText.ThemeName(SiteText.ThemeSystem)</span>
                </summary>
                <fieldset class="menu-panel">
                    <legend class="visually-hidden">@SiteText.ThemeLabel</legend>
                    <label><input type="radio" name="theme" value="system" checked autocomplete="off"> @SiteText.ThemeSystem</label>
                    <label><input type="radio" name="theme" value="light" autocomplete="off"> @SiteText.ThemeLight</label>
                    <label><input type="radio" name="theme" value="dark" autocomplete="off"> @SiteText.ThemeDark</label>
                </fieldset>
            </details>
        </div>
        <div class="wrap header-nav">
            @* The tools, the same on every page; the current tool's link is marked. *@
            <nav class="tool-nav" aria-label="@SiteText.ToolTabsLabel">
                <ul>
                    @foreach (var (tab, href, text) in new[] {
                                 (BeastieBot3.Site.Web.ToolPaths.Tab.Cite, BeastieBot3.Site.Web.ToolPaths.Cite, SiteText.ToolCite),
                                 (BeastieBot3.Site.Web.ToolPaths.Tab.Update, BeastieBot3.Site.Web.ToolPaths.UpdateStatuses, SiteText.ToolUpdateLink),
                                 (BeastieBot3.Site.Web.ToolPaths.Tab.List, BeastieBot3.Site.Web.ToolPaths.ListMaker, SiteText.ToolListMaker),
                             }) {
                        <li><a href="@href" aria-current="@(tab == toolTab ? "page" : null)">@text</a></li>
                    }
                </ul>
            </nav>
            <nav class="site-nav" aria-label="Site">
                <a href="/about">@SiteText.NavAbout</a>
            </nav>
        </div>
    </header>
    <main id="main" class="wrap" tabindex="-1">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="wrap">
            <p>@SiteText.FooterLine1</p>
            @if (version is not null) {
                <p>@SiteText.FooterLine2Before(version)<a href="@SiteText.TermsUrl">@SiteText.TermsLink</a>@SiteText.FooterLine2Middle<a href="/about">@SiteText.AboutPageLink</a>.</p>
            }
            @if (built is not null) {
                <p>@SiteText.FooterUpdated(built, apiRange)</p>
            }
            @if (!string.IsNullOrWhiteSpace(sourceUrl)) {
                <p><a href="@sourceUrl">@SiteText.SourceCode</a></p>
            }
        </div>
    </footer>
</body>
</html>
