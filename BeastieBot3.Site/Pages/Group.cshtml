@page "/taxa/{rank}/{name}"
@model GroupModel
@using BeastieBot3.Site.Lists
@using BeastieBot3.Site.Web
@{
    var group = Model.Group;
    if (group is null) {
        ViewData["Title"] = Model.Candidates.Count > 0
            ? GroupText.ChooseHeading(Model.Candidates.Count, Model.Candidates[0].Group.Rank, Model.Candidates[0].Group.Name)
            : GroupText.NotFoundHeading(Model.RequestedRank.ToLowerInvariant(), Model.RequestedName);
        ViewData["NoIndex"] = true;
    } else {
        ViewData["Title"] = GroupText.Title(GroupList.HeadingText(group), group.CommonNameEn);
    }
}
@if (group is null) {
    @if (Model.Candidates.Count > 0) {
        <h1>@ViewData["Title"]</h1>
        <ul class="group-choices">
            @foreach (var (candidate, path) in Model.Candidates) {
                <li>
                    <a href="@Model.UrlOf(candidate)">@GroupList.HeadingText(candidate)</a>
                    <span class="group-path">@string.Join(" › ", path.Where(p => p.NodeId != candidate.NodeId).Select(p => p.Name))</span>
                </li>
            }
        </ul>
    } else {
        <h1>@ViewData["Title"]</h1>
        <p>@GroupText.NotFoundLine(Model.RequestedName)</p>
        <partial name="_SearchForm" model="@(new SearchFormModel(Model.RequestedName, "main"))" />
    }
    return;
}
@{
    var above = Model.Path.Where(p => p.NodeId != group.NodeId).ToList();
    var threatened = Model.CountOf(CategoryGroups.Threatened);
    var extinct = Model.CountOf(CategoryGroups.Extinct);
    var counts = Model.Counts
        .Select(c => (Count: c, Section: StatusSection.For(c.Category)))
        .OrderBy(c => c.Section is null ? int.MaxValue : StatusSection.All.ToList().IndexOf(c.Section))
        .ThenBy(c => c.Count.Category, StringComparer.Ordinal)
        .ToList();
    var showInfraColumn = counts.Any(c => c.Count.Infra > 0);
    var childRanks = Model.Children.Select(c => c.Group.Rank).Distinct().ToList();
    var iucnParent = above.LastOrDefault(p => !p.IsCol);
    ViewData["PageTools"] = new List<(string, string)> { (GroupText.ToolListLink(GroupList.InSentence(group)), SiteUrls.GroupList(group)) };
}

@if (Model.ArrivedQuery is { } arrived) {
    <p class="arrival">
        <a href="/search?q=@Uri.EscapeDataString(arrived)&amp;all=1">@SiteText.ArrivedAllResults(arrived)</a>
    </p>
}

<header class="taxon-header group-header">
    <h1>
        @if (group.ShowRank && group.Rank != "unranked") {
            <span class="rank-word">@GroupList.Capitalize(group.Rank)</span>
        }
        <span class="@(group.IsGenus ? "sci-name" : "group-name")">@group.Name</span>
    </h1>
    @if (group.CommonNameEn is not null) {
        <p class="taxon-common-name">@group.CommonNameEn</p>
    }
    @if (above.Count > 0) {
        <div class="classification">
            <h2 class="visually-hidden">@GroupText.HeadingClassification</h2>
            <ol>
                @foreach (var step in above) {
                    <li class="@(step.IsCol ? "col-group" : null)"><span class="rank">@(step.ShowRank ? GroupList.Capitalize(step.Rank) : null)</span> <a href="@SiteUrls.Group(step)">@step.Name</a></li>
                }
            </ol>
        </div>
    }
</header>

<section class="group-facts" aria-label="@GroupText.LabelSpecies">
    <dl class="facts">
        <dt>@GroupText.LabelSpecies</dt>
        <dd>@SiteFormat.Number(group.SpeciesCount)</dd>
        <dt>@GroupText.LabelThreatened</dt>
        <dd>@SiteFormat.Number(threatened) <span class="help">@GroupText.ThreatenedNote</span></dd>
        <dt>@GroupText.LabelExtinct</dt>
        <dd>@SiteFormat.Number(extinct)</dd>
        @if (group.InfraCount > 0) {
            <dt>@GroupText.LabelInfra</dt>
            <dd>@SiteFormat.Number(group.InfraCount)</dd>
        }
        @if (group.SubpopulationCount > 0) {
            <dt>@GroupText.LabelSubpopulations</dt>
            <dd>@SiteFormat.Number(group.SubpopulationCount)</dd>
        }
        @if (Model.Version is not null) {
            <dt>@SiteText.LabelVersion</dt>
            <dd>@Model.Version</dd>
        }
    </dl>
    @if (group.IsCol) {
        <p class="note">@GroupText.ColGroupNote(GroupList.HeadingText(group), group.Rank, iucnParent?.Rank, iucnParent?.Name)</p>
    } else if (group.IsFromRule) {
        <p class="note">@GroupText.RuleGroupNote(group.Rank)</p>
    }
    @if (Model.WikipediaNames.Count > 0) {
        <p class="group-wikipedia-names"><span class="label">@GroupText.WikipediaNamesLabel</span>
            @for (var i = 0; i < Model.WikipediaNames.Count; i++) {
                var title = Model.WikipediaNames[i];
                <a href="@SiteFormat.WikipediaUrl(title)" hreflang="en">@title</a>@(i < Model.WikipediaNames.Count - 1 ? ", " : null)
            }
        </p>
    }
    @if (Model.ColNames.Count > 0) {
        <p class="group-col-names"><span class="label">@GroupText.OtherNamesLabel</span> @string.Join(", ", Model.ColNames)</p>
    }
    @if (group.EnwikiTitle is not null || group.ColId is not null) {
        <ul class="group-links">
            @if (group.EnwikiTitle is { } title) {
                <li><a href="@SiteFormat.WikipediaUrl(title)">@GroupText.LinkWikipedia</a></li>
            }
            @if (group.ColId is { } colId) {
                <li><a href="@SiteFormat.CatalogueOfLifeUrl(colId)">@GroupText.LinkCol</a></li>
            }
        </ul>
    }
</section>

@if (counts.Count > 0) {
    <section class="group-categories" aria-labelledby="categories-heading">
        <h2 id="categories-heading">@GroupText.HeadingCategories</h2>
        <table class="data-table">
            <thead>
                <tr>
                    <th scope="col">@GroupText.ColumnCategory</th>
                    <th scope="col" class="num">@GroupText.ColumnSpecies</th>
                    @if (showInfraColumn) {
                        <th scope="col" class="num">@GroupText.ColumnInfra</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var (count, _) in counts) {
                    <tr>
                        <td><partial name="_Badge" model="@BadgeModel.ForStatusCode(count.Category, showLabel: true)" /></td>
                        <td class="num">@SiteFormat.Number(count.Species)</td>
                        @if (showInfraColumn) {
                            <td class="num">@SiteFormat.Number(count.Infra)</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
        <p class="help">@GroupText.CategoriesNote</p>
    </section>
}

@if (Model.Children.Count > 0) {
    <section class="group-children" aria-labelledby="children-heading">
        <h2 id="children-heading">@GroupText.HeadingChildren(childRanks.Count == 1 ? childRanks[0] : null, group.Name, Model.Children.Count)</h2>
        <table class="data-table">
            <thead>
                <tr>
                    <th scope="col">@GroupText.ColumnTaxon</th>
                    <th scope="col">@GroupText.ColumnCommonName</th>
                    <th scope="col" class="num">@GroupText.ColumnSpecies</th>
                    <th scope="col" class="num">@GroupText.ColumnThreatened</th>
                    <th scope="col" class="num">@GroupText.ColumnExtinct</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var child in Model.Children) {
                    var c = child.Group;
                    <tr>
                        <td>
                            @if (c.ShowRank && c.Rank != "unranked") {
                                <span class="rank">@GroupList.Capitalize(c.Rank)</span>
                            }
                            <a href="@SiteUrls.Group(c)" class="@(c.IsGenus ? "sci-name" : null)">@c.Name</a>
                            @if (c.IsCol) {
                                <abbr class="col-marker" title="@GroupText.ColMarkerTitle">@GroupText.ColMarker</abbr>
                            }
                        </td>
                        <td>@c.CommonNameEn</td>
                        <td class="num">@SiteFormat.Number(c.SpeciesCount)</td>
                        <td class="num">@SiteFormat.Number(child.Threatened)</td>
                        <td class="num">@SiteFormat.Number(child.Extinct)</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

<section class="tools" id="tools" aria-labelledby="tools-heading">
    <h2 id="tools-heading">@SiteText.HeadingTools</h2>
    <ul class="tool-links">
        <li><a href="@SiteUrls.GroupList(group)">@GroupText.ToolListLink(GroupList.InSentence(group))</a> <span class="help">@GroupText.ToolListHelp</span></li>
        <li><a href="/update">@SiteText.ToolUpdateLink</a> <span class="help">@SiteText.ToolUpdateHelp</span></li>
    </ul>
</section>
