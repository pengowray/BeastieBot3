@page "/species/{taxonId:long}/wikitext"
@model SpeciesWikitextModel
@{
    var taxon = Model.Taxon;
    if (taxon is null) {
        ViewData["Title"] = SiteText.TaxonNotFoundHeading(Model.RequestedTaxonId);
        ViewData["HideHeaderSearch"] = true;
    } else {
        ViewData["Title"] = SiteText.WikitextPageTitle(taxon.SubpopulationName is { Length: > 0 } subpopulation ? $"{taxon.ScientificName} {subpopulation}" : taxon.ScientificName);
    }
}
@if (taxon is null) {
    <h1>@SiteText.TaxonNotFoundHeading(Model.RequestedTaxonId)</h1>
    <p>@(Model.Version is null ? SiteText.TaxonNotFoundLineNoVersion : SiteText.TaxonNotFoundLine(Model.Version))</p>
    <partial name="_SearchForm" model="@(new SearchFormModel(null, "main"))" />
    return;
}
@{
    var selected = Model.Selected;
    var nameHtml = ScientificNameMarkup.ToHtml(taxon.ScientificName, taxon.SubpopulationName);
}

<header class="taxon-header tool-header">
    <p class="tool-label">@SiteText.WikitextPageLabel</p>
    <h1><span class="sci-name">@Html.Raw(nameHtml)</span></h1>
    @if (taxon.CommonNameEn is not null) {
        <p class="taxon-common-name">@taxon.CommonNameEn</p>
    }
    <p class="tool-back"><a href="/species/@taxon.TaxonId">@SiteText.TaxonPageFor<span class="sci-name">@Html.Raw(nameHtml)</span></a></p>
</header>

@if (selected is null) {
    <p class="note">@SiteText.WikitextChooseAssessment(Model.Version)</p>
}

@if (selected is not null) {
    <section class="wikitext" id="wikitext" aria-labelledby="wikitext-heading"
             data-copied="@SiteText.Copied" data-copy-label="@SiteText.Copy" data-copy-failed="@SiteText.CopyFailed" data-copy-failed-button="@SiteText.CopyFailedButton"
             data-live-updated="@SiteText.WikitextUpdated" data-live-too-many="@SiteText.WikitextTooManyRequests" data-options-url="@Model.CurrentOptionsUrl">
        <h2 id="wikitext-heading">@SiteText.HeadingWikitext</h2>
        @{
            var selectedCategory = IucnCategories.Describe(selected).Label;
        }
        @* site.js replaces each data-live-region element with the one of the same id when the
           citation options change. The form is never replaced, so it keeps focus and typing. *@
        <div class="wikitext-output" id="wikitext-output" data-live-region>
        @if (!selected.IsGlobal) {
            <p class="note note-selected">
                @SiteText.RegionalAssessment(selected.Scope, selectedCategory, selected.YearPublished, Model.VersionNote(selected))
                @SiteText.TaxoboxGlobalOnly(Model.Taxobox.Label)
                @if (Model.LatestGlobal is not null && Model.InRelease) {
                    <a href="@(Model.OptionsUrl(null))#wikitext">@SiteText.ShowLatestWikitext</a>
                }
            </p>
        } else if (!Model.SelectedIsDefault) {
            <p class="note note-selected">
                @SiteText.EarlierAssessment(selectedCategory, selected.YearPublished, Model.VersionNote(selected))
                @if (Model.StatusAssessment is not null) {
                    <a href="@(Model.OptionsUrl(null))#wikitext">@SiteText.ShowLatestWikitext</a>
                }
            </p>
        }
        @if (IucnCategories.IsEarlierVersionCode(selected)) {
            <p class="note">@SiteText.NoTemplateEarlierVersion(Model.Taxobox.Name)</p>
        } else if (!IucnCategories.HasStatusTemplateCode(selected)) {
            <p class="note">@SiteText.NoTemplateCode(Model.Taxobox.Noun)</p>
        }

        @if (Model.Parts is null) {
            <p class="note">
                @SiteText.NoCitationReason
                @if (IucnCategories.HasStatusTemplateCode(selected)) {
                    @SiteText.NoCitationStatusAvailable
                }
                @SiteText.NoCitationBefore<a href="@SiteFormat.IucnAssessmentUrl(selected.TaxonId, selected.AssessmentId)">@SiteText.NoCitationLink</a>@SiteText.NoCitationAfter
            </p>
        }

        @foreach (var box in Model.Boxes) {
            <div class="wikitext-box">
                <partial name="_WikitextBoxContent" model="box" />
                @if (box.Id == "wikitext-speciesbox" && Model.TaxoboxCheck is { } taxoboxCheck) {
                    <div class="taxobox-status note">
                        <strong>@SiteText.TaxoboxStatusHeading:</strong>
                        <partial name="_TaxoboxStatus" model="@(new TaxoboxStatusView(taxoboxCheck, Model.LatestGlobal))" />
                    </div>
                }
                @if (box.Id == "wikitext-cite") {
                    <div class="citation-notes">
                        @if (Model.DoiNote is not null) {
                            <p class="note">@Model.DoiNote</p>
                        }
                        @if (Model.UnsplitAuthors.Count > 0) {
                            <p class="note">@SiteText.AuthorsUnsplit @string.Join("; ", Model.UnsplitAuthors)</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Parts?.IucnCitationText)) {
                            <details class="iucn-citation" id="iucn-citation">
                                <summary>@SiteText.IucnCitationLabel</summary>
                                <p>@Model.Parts.IucnCitationText</p>
                            </details>
                        }
                        @if (Model.Credits is { } credits) {
                            <partial name="_AssessmentCredits" model="credits" />
                        }
                    </div>
                }
                @if (box.Id == "wikitext-green") {
                    <div class="citation-notes">
                        <p class="note">@(Model.Options.GreenStatusYear == GreenStatusYearRule.Published ? SiteText.GreenStatusCiteNoteYearPublished : SiteText.GreenStatusCiteNoteYearAssessed)</p>
                        <p class="note">@SiteText.GreenStatusCiteNoteNumber</p>
                    </div>
                }
            </div>
        }
        @if (Model.Credits is { } creditsWithoutCitation && !Model.Boxes.Any(b => b.Id == "wikitext-cite")) {
            <div class="citation-notes">
                <partial name="_AssessmentCredits" model="creditsWithoutCitation" />
            </div>
        }
        </div>

        @if (Model.Parts is not null) {
            <form class="options-form" method="get" action="@(SpeciesWikitextModel.PathFor(taxon.TaxonId))#wikitext">
                <fieldset>
                    <legend>@SiteText.OptionsLegend</legend>
                    <input type="hidden" name="opts" value="1">
                    @if (!Model.SelectedIsDefault) {
                        <input type="hidden" name="assessment" value="@selected.AssessmentId">
                    }
                    <fieldset class="option-group">
                        <legend>@SiteText.AuthorsLabel</legend>
                        <label><input type="radio" name="authors" value="author" checked="@(Model.Options.AuthorStyle == CiteAuthorStyle.AuthorN)"> @Html.Raw(SiteText.AuthorsAuthorHtml)</label>
                        <label><input type="radio" name="authors" value="lastfirst" checked="@(Model.Options.AuthorStyle == CiteAuthorStyle.LastFirst)"> @Html.Raw(SiteText.AuthorsLastFirstHtml)</label>
                        @if (Model.GivenNames is { } given) {
                            <label class="option-extra"><input type="checkbox" name="fullnames" value="1" checked="@Model.Options.FullGivenNames" aria-describedby="fullnames-help"> @SiteText.FullGivenNames</label>
                            <p class="help" id="fullnames-help">@SiteText.FullGivenNamesHelp(given.WithGivenNames, given.People, given.Example.GivenNames!.Trim(), given.Example.Display.Trim())</p>
                        } else if (Model.Options.FullGivenNames) {
                            @* Kept for the next assessment shown, which may have full given names. *@
                            <input type="hidden" name="fullnames" value="1">
                        }
                    </fieldset>
                    <fieldset class="option-group">
                        <legend>@SiteText.AccessLabel</legend>
                        @if (Model.DownloadDateText is not null) {
                            <label><input type="radio" name="access" value="download" checked="@(Model.Options.Access == WikitextOptions.AccessDownload)" aria-describedby="access-help"> @SiteText.AccessDownload(Model.DownloadDateText)</label>
                        }
                        <label><input type="radio" name="access" value="today" checked="@(Model.Options.Access == WikitextOptions.AccessToday)"> @SiteText.AccessToday(Model.TodayText)</label>
                        <label><input type="radio" name="access" value="none" checked="@(Model.Options.Access == WikitextOptions.AccessNone || (Model.DownloadDateText is null && Model.Options.Access == WikitextOptions.AccessDownload))"> @SiteText.AccessNone</label>
                        @if (Model.DownloadDateText is not null) {
                            <p class="help" id="access-help">@SiteText.AccessHelp</p>
                        }
                    </fieldset>
                    <div class="option-group">
                        <label><input type="checkbox" name="ref" value="1" checked="@Model.Options.WrapInRef"> @Html.Raw(SiteText.RefWrapHtml)</label>
                        <label class="ref-name">@SiteText.RefName <input type="text" name="refname" value="@Model.Options.RefName" maxlength="@WikitextOptions.MaxRefNameLength" size="20" spellcheck="false" aria-describedby="refname-help"></label>
                        <p class="help" id="refname-help">@SiteText.RefNameHelp</p>
                    </div>
                    <partial name="_StatusRefTemplate" model="Model" />
                    @if (Model.GreenStatus is not null) {
                        <fieldset class="option-group">
                            <legend>@SiteText.GreenStatusYearLegend</legend>
                            <label><input type="radio" name="@WikitextOptions.GreenStatusYearKey" value="assessed" checked="@(Model.Options.GreenStatusYear == GreenStatusYearRule.Assessed)" aria-describedby="gsyear-help"> @SiteText.GreenStatusYearAssessed</label>
                            <label><input type="radio" name="@WikitextOptions.GreenStatusYearKey" value="@WikitextOptions.GreenStatusYearPublished" checked="@(Model.Options.GreenStatusYear == GreenStatusYearRule.Published)" aria-describedby="gsyear-help"> @SiteText.GreenStatusYearPublished</label>
                            <p class="help" id="gsyear-help">@SiteText.GreenStatusYearHelp</p>
                        </fieldset>
                    } else if (Model.Options.GreenStatusYear == GreenStatusYearRule.Published) {
                        @* Kept for the next page shown, which may have a Green Status. *@
                        <input type="hidden" name="@WikitextOptions.GreenStatusYearKey" value="@WikitextOptions.GreenStatusYearPublished">
                    }
                    <div class="option-group">
                        <label><input type="checkbox" name="amp" value="1" checked="@Model.Options.Amp" aria-describedby="amp-help"> @Html.Raw(SiteText.AmpHtml)</label>
                        <p class="help" id="amp-help">@SiteText.AmpHelp</p>
                    </div>
                    @* site.js hides the button and updates the wikitext as soon as an option changes,
                       saying so in the status line. *@
                    <button type="submit">@SiteText.UpdateWikitext</button>
                    <p class="live-status" role="status" data-live-status hidden></p>
                </fieldset>
            </form>
        }

        @if (Model.Wikidata is { } wikidata) {
            <section class="wikidata-cite" id="wikidata-cite" aria-labelledby="wikidata-cite-heading" data-live-region>
                <h3 id="wikidata-cite-heading">@SiteText.HeadingWikidataCite</h3>
                @if (wikidata.ItemQid is { } itemQid) {
                    <p class="wikidata-item">@SiteText.WikidataItemBefore<a href="@wikidata.ItemUrl">@itemQid</a></p>
                    @if (wikidata.CiteQ is { } citeQ) {
                        <div class="wikitext-box">
                            <partial name="_WikitextBoxContent" model="citeQ" />
                        </div>
                        <p class="note"><a href="@SiteText.CiteQGuidanceUrl">@SiteText.CiteQGuidanceLink</a>@SiteText.CiteQGuidanceAfter</p>
                    }
                    @if (wikidata.ItemIsForAssessmentId is { } owner) {
                        @if (wikidata.ItemAssessmentHasPage) {
                            <p class="wikidata-borrowed">@SiteText.BorrowedItemBefore<a href="@(Model.OptionsUrl(owner))#wikidata-cite">@SiteText.BorrowedItemLink</a>.</p>
                        } else {
                            <p class="wikidata-borrowed">@SiteText.BorrowedItemNoPage(owner)</p>
                        }
                    }
                    <partial name="_WikidataName" model="wikidata" />
                    @if (wikidata.Commands is { } add) {
                        var changes = wikidata.Changes;
                        @if (changes.Count == 0) {
                            <p class="wikidata-missing">@SiteText.MissingStatements(string.Join(", ", wikidata.AddedStatements)) @SiteText.AddStatementsLine</p>
                        } else {
                            @if (wikidata.AddedStatements.Count > 0) {
                                <p class="wikidata-missing">@SiteText.MissingStatements(string.Join(", ", wikidata.AddedStatements))</p>
                            }
                            <partial name="_WikidataItemChanges" model="wikidata" />
                            <p>@SiteText.RunCommandsLine</p>
                        }
                        <partial name="_WikidataMainSubject" model="wikidata" />
                        <div class="wikitext-box">
                            <partial name="_WikitextBoxContent" model="add" />
                        </div>
                        @if (wikidata.QuickStatementsUrl is { } addUrl) {
                            <p class="quickstatements-link"><a href="@addUrl">@SiteText.OpenInQuickStatements</a></p>
                        }
                    }
                } else {
                    <p class="wikidata-item">@SiteText.NoWikidataItem</p>
                    @if (wikidata.NoUsableName && wikidata.CitationName is { } internalName) {
                        <p>@SiteText.NoUsableName(internalName)</p>
                    }
                    @if (wikidata.Commands is { } create) {
                        <p>
                            @if (wikidata.SearchUrl is { } searchUrl) {
                                @SiteText.SearchWikidataBefore<a href="@searchUrl">@SiteText.SearchWikidataLink</a>@SiteText.SearchWikidataAfter
                            }
                            @SiteText.CreateItemLine
                        </p>
                        <partial name="_WikidataName" model="wikidata" />
                        <partial name="_WikidataMainSubject" model="wikidata" />
                        <div class="wikitext-box">
                            <partial name="_WikitextBoxContent" model="create" />
                        </div>
                        @if (wikidata.QuickStatementsUrl is { } createUrl) {
                            <p class="quickstatements-link"><a href="@createUrl">@SiteText.OpenInQuickStatements</a></p>
                        }
                    }
                }
            </section>
        }
        @if (Model.WikidataStatus is { HasContent: true } wikidataStatus && Model.LatestGlobal is { } latestGlobal) {
            <partial name="_WikidataStatus" model="@(new WikidataStatusPartial(wikidataStatus, latestGlobal, Model.Version))" />
        }
    </section>
}

<partial name="_AssessmentTables" model="Model" />
