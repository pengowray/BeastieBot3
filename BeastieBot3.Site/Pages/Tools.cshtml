@page "/tools"
@model ToolsModel
@using BeastieBot3.Site.Web
@{
    ViewData["Title"] = SiteText.HeadingTools;
}
<partial name="_ToolTabs" model="ToolPaths.Tab.None" />
<h1>@SiteText.HeadingTools</h1>
<ul class="tool-list">
    <li><a href="@ToolPaths.Cite">@SiteText.ToolCite</a> <span class="help">@SiteText.ToolCiteLine</span></li>
    <li><a href="@ToolPaths.UpdateStatuses">@SiteText.ToolUpdateLink</a> <span class="help">@SiteText.ToolUpdateLine</span></li>
    <li><a href="@ToolPaths.ListMaker">@SiteText.ToolListMaker</a> <span class="help">@SiteText.ToolListMakerLine</span></li>
</ul>
