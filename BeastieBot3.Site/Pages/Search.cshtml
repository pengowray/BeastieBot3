@page "/search"
@model SearchModel
@{
    ViewData["HideHeaderSearch"] = true;
    ViewData["NoIndex"] = true;
    var hasResults = Model.Query.Length > 0 && !Model.TooShort;
    ViewData["Title"] = hasResults ? SiteText.SearchHeading(Model.Query) : SiteText.SearchLabel;
}
@if (!hasResults) {
    @* With no results to head, the page is headed "Search for a taxon"; the form's label says the
       same, so it is kept for screen readers only. *@
    <h1>@SiteText.SearchLabel</h1>
    <partial name="_SearchForm" model="@(new SearchFormModel(Model.Query, "main", HideLabel: true))" />
    @if (Model.TooShort) {
        <p class="message">@SiteText.TooShort</p>
    }
} else {
    <partial name="_SearchForm" model="@(new SearchFormModel(Model.Query, "main"))" />
    <h1>@SiteText.SearchHeading(Model.Query)</h1>
    @if (Model.Items.Count == 0) {
        <p class="message">@SiteText.NoResults(Model.Query)</p>
    } else {
        <p class="result-count">@(Model.TotalTaxa > Model.Items.Count
            ? SiteText.SearchTruncated(Model.Items.Count, Model.TotalTaxa)
            : SiteText.SearchCount(Model.Items.Count))</p>
        <partial name="_TaxonList" model="Model.Items" />
    }
}
